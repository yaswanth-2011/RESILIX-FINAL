    "Drag to tilt the map from top-down (0°) to cinematic (75°).": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানচিত্রটি উপর থেকে নিচে (0°) থেকে সিনেমাটিক (75°) পর্যন্ত টিল্ট করতে টানুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to tilt the map from top-down (0°) to cinematic (75°)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નકશાને ઉપરથી નીચે (0°) થી સિનેમેટિક (75°) સુધી ટિલ્ટ કરવા ખેંચો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैप को ऊपर से नीचे (0°) से सिनेमैटिक (75°) तक टिल्ट करने के लिए खींचें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಕ್ಷೆಯನ್ನು ಮೇಲಿನಿಂದ (0°) ಸಿನೆಮಾಟಿಕ್ (75°) ವರೆಗೆ ಟಿಲ್ಟ್ ಮಾಡಲು ಎಳೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭൂട്ടം മുകളിൽ (0°) മുതൽ സിനിമാറ്റിക് (75°) വരെ ടിൽട്ട് ചെയ്യാൻ വലിച്ചുകടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नकाशा टॉप-डाउन (0°) पासून सिनेमॅटिक (75°) पर्यंत टिल्ट करण्यासाठी ओढा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਕਸ਼ੇ ਨੂੰ ਉੱਪਰ ਤੋਂ ਹੇਠਾਂ (0°) ਤੱਕ ਸਿਨੈਮੈਟਿਕ (75°) ਤੱਕ ਟਿਲਟ ਕਰਨ ਲਈ ਖਿੱਚੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரைபடத்தை மேலிருந்து கீழாக (0°) சினமாடிக் (75°) வரை சாய்த்த கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మ్యాప్‌ను టాప్-డౌన్ (0°) నుండి సినమాటిక్ (75°) వరకు టిల్ట్ చేయడానికి లాగండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نقشے کو اوپر سے نیچے (0°) سے سنیمیٹک (75°) تک ٹِلت کرنے کے لیے کھینچیں۔"
          }
        }
      }
    },
    "Drop new assets into Assets.xcassets to replace — no code change needed.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন অ্যাসেট Assets.xcassets-এ রাখুন — কোড পরিবর্তনের দরকার নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop new assets into Assets.xcassets to replace — no code change needed."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બદલવા નવા એસેट્સ Assets.xcassets માં મૂકો — કોડ બદલવાની જરૂર નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने के लिए नए एसेट्स Assets.xcassets में डालें — कोड में कोई बदलाव ज़रूरी नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಿಸಲು ಹೊಸ ಆಸ್ತಿಗಳನ್ನು Assets.xcassets ನಲ್ಲಿ ಇರಿಸಿ — ಕೋಡ್ ಬದಲಾವಣೆ ಅಗತ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറ്റാൻ പുതിയ ആസ്തികൾ Assets.xcassets-ലേക്ക് ഇടുക — കോഡ് മാറ്റം വേണ്ട."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने के लिए नए एसेट्स Assets.xcassets में डालें — कोड में कोई बदलाव ज़रूरी नहीं।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲਣ ਲਈ ਨਵੀਆਂ ਐਸੈਟਾਂ Assets.xcassets ਵਿੱਚ ਰੱਖੋ — ਕੋਡ ਬਦਲਣ ਦੀ ਲੋੜ ਨਹੀਂ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்ற புதிய சொத்துகளை Assets.xcassets இல் சேர்க்கவும் — கோடு மாற்றம் தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భర్తీ చేయడానికి కొత్త ఆస్తులను Assets.xcassets లో పెట్టండి — కోడ్ మార్పులు అవసరం లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیل کرنے کے لیے نئے ایسٹس Assets.xcassets میں رکھیں — کوڈ میں تبدیلی ضروری نہیں۔"
          }
        }
      }
    },
