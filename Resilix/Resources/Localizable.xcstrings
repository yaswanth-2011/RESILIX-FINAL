            "value": "मल्टीमोडल, 128K संदर्भ, मजकूर आणि प्रतिमा इनपुट."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਲਟੀਮੋਡਲ, 128K ਸੰਦਰਭ, ਟੈਕਸਟ ਅਤੇ ਤਸਵੀਰ ਇਨਪੁੱਟ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல்மோடல், 128K சூழல், உரை மற்றும் பட உள்ளீடு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మల్టీమోడల్, 128K సందర్భం, టెక్స్ట్ మరియు చిత్ర ఇన్‌పుట్."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملٹی موڈل، 128K سیاق، ٹیکسٹ اور تصویر ان پٹ۔"
          }
        }
      }
    },
