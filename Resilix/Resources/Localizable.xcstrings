    "The bundled first-aid topics cover:": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বান্ডিল করা প্রাথমিক চিকিৎসা বিষয়:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled first-aid topics cover:"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંધલ કરેલા પ્રાથમિક ઉપચાર વિષયો:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंडल किए गए प्राथमिक चिकित्सा विषय:"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೇರಿಸಿದ ಪ್ರಥಮ ಚಿಕಿತ್ಸಾ ವಿಷಯಗಳು:"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബണ്ഡലിലുള്ള പ്രഥമ ചികിത്സാ വിഷയങ്ങൾ:"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समाविष्ट प्राथमिक उपचार विषय:"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੰਡਲ ਕੀਤੇ ਪਹਿਲੀ ਮੱਦ ਵਿਸ਼ਾ:"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்ட முதலாம்சரி வைத்திய விஷயங்கள்:"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బండిల్ చేసిన ప్రాథమిక చికిత్సా అంశాలు:"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بنڈل شدہ ابتدائی طبی موضوعات:"
          }
        }
      }
    },
