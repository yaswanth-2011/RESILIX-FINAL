    "Communicate with nearby people even when normal networks are unavailable.": {
      "comment": "A description of the app's main feature.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাভাবিক নেটওয়ার্ক না থাকলেও কাছের মানুষদের সঙ্গে যোগাযোগ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Communicate with nearby people even when normal networks are unavailable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામાન્ય નેટવર્ક ઉપલબ્ધ ન હોય તો પણ નજીકના લોકો સાથે વાત કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य नेटवर्क उपलब्ध न होने पर भी आस-पास के लोगों से संवाद करें."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಮಾನ್ಯ ನೆಟ್‌ವರ್ಕ್ ಇಲ್ಲದಿದ್ದರೂ ಹತ್ತಿರದ ಜನರೊಂದಿಗೆ ವರ್ಷಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധാരണ നെറ്റ്‌വർക്കുകൾ ഇല്ലെങ്കിലും അടുത്തുള്ള ആളുമായി സംസാരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य नेटवर्क उपलब्ध न होने पर भी आस-पास के लोगों से संवाद करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਮ ਨੈੱਟਵਰਕ ਉਪਲਬਧ ਨਾ ਹੋਣ 'ਤੇ ਵੀ ਨੇੜਲਿਆਂ ਲੋਕਾਂ ਨਾਲ ਗੱਲ ਕਰੋ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சா஧ாரண நెట్‌వర్క్‌లు இல்லாவிட்டாலும் அருகிலுள்ளவர்களுடன் பேசுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధారణ నెట్‌వర్క్‌లు లేకపోతే కూడా దగ్గరి వ్యక్తులతో సంవాదించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عام نیٹ ورک دستیاب نہ ہو تو بھی قریبی لوگوں سے رابطہ کریں۔"
          }
        }
      }
    },
