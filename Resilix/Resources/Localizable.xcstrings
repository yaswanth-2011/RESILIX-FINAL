    "Ask whether the person is choking and can speak.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জিজ্ঞাসা করুন ব্যক্তির শ্বাস আটকে আছে কিনা এবং কথা বলতে পারে কিনা।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask whether the person is choking and can speak."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂછો કે વ્યક્તિને ગળું અટકી ગયું છે અને તે બોલી શકે છે કે નહીં."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें कि व्यक्ति का गला घुट रहा है और क्या वह बोल सकता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವ್ಯಕ್ತಿ ಗಂಬಿ ತಡೆಯುತ್ತಿದ್ದನೆ ಮತ್ತು ಮಾತನಾಡಬಹುದೇ ಎಂದು ಕೇಳಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആള് ശ്വാസം തടയുന്നുണ്ടോ, സംസാരിക്കാമോ എന്ന് ചോദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें कि व्यक्ति का गला घुट रहा है और क्या वह बोल सकता है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوچھیں کہ کیا شخص کا گلا رک گیا ہے اور کیا وہ بول سکتا ہے۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நபர் மூக்கு அடைப்பதாகவும் பேச முடியுமா என்று கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తి మూర్గిలిపోతున్నారా మరియు మాట్లాడగలరా అని అడగండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
