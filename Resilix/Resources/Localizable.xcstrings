    "Set mode to Tilted or Cinematic to adjust the 3D tilt.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ঝুঁক বদলাতে মোড Tilted বা Cinematic করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set mode to Tilted or Cinematic to adjust the 3D tilt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ઝુકાવું બદલવા મોડને Tilted અથવા Cinematic કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3D झुकाव बदलने के लिए मोड को Tilted या Cinematic पर सेट करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ಟಿಲ್ಟ್ ಬದಲಾಯಿಸಲು ಮೋಡ್ ಅನ್ನು Tilted ಅಥವಾ Cinematic ಗೆ ಹೊಂದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ടിൽട്ട് മാറ്റാൻ മോഡ് Tilted അല്ലെങ്കിൽ Cinematic ആക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "3D झुकाव बदलने के लिए मोड को Tilted या Cinematic पर सेट करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ਟਿਲਟ ਬਦਲਣ ਲਈ ਮੋਡ ਨੂੰ Tilted ਜਾਂ Cinematic ਕਰੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "3D சாய்வை மாற்ற மோடை Tilted அல்லது Cinematic என அமைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "3D టిల్ట్‌ను సరిచేయడానికి మోడ్‌ను Tilted లేదా Cinematic‌కు సెట్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3D ٹِلت بدلنے کے لیے موڈ کو Tilted یا Cinematic کریں۔"
          }
        }
      }
    },
