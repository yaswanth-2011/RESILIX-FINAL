          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਈਮੇਲ ਅਤੇ ਪਾਸਵਰਡ ਦਰਜ ਕਰੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மின்னஞ்சல் மற்றும் கடவுச்சொல்லை உள்ளிடவும்."
