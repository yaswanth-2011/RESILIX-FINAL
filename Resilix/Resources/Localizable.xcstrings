    "Monitor the person for signs of shock.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শক সাংকেতিক লক্ষণের জন্য ব্যক্তিকে পর্যবেক্ষণ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor the person for signs of shock."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઘાતના લક્ષણો માટે વ્યક્તિનું નિરીક્ષણ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आघात के लक्षणों के लिए व्यक्ति की निगरानी रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಷಾಕ್ ಲಕ್ಷಣಗಳಿಗೆ ವ್ಯಕ್ತಿಯನ್ನು ಗಮನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷോക്കിന്റെ ലക്ഷണങ്ങൾക്കായി ആളുടെ അവസ്ഥ നോക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आघात के लक्षणों के लिए व्यक्ति की निगरानी रखें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "冲击 کی علامات کے لیے شخص کی نگرانی کریں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிர்ச்சியின் அறிகுறிகளுக்காக நபரைக் கண்காணிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షాక్ లక్షణాల కోసం వ్యక్తిని గమనించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Move the person to a warm, dry, sheltered place.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিকে উষ্ণ, শুষ্ক ও নিরাপদ জায়গায় নিয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the person to a warm, dry, sheltered place."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વ્યક્તિને ગરમ, સૂકી અને સુરક્ષિત સ્થળે લઈ જાઓ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्ति को गर्म, सूखे और सुरक्षित स्थान पर ले जाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವ್ಯಕ್ತಿಯನ್ನು ಬೆಚ್ಚಗಿನ, ಒಣ, ಸುರಕ್ಷಿತ ಸ್ಥಳಕ್ಕೆ ಕರೆದೊಂಡೊಳ್ಳಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തിയെ ചൂടുള്ള, ഉണക്ക, സുരക്ഷിതമായ സ്ഥലത്തിലേക്ക് മാറ്റുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्ति को गर्म, सूखे और सुरक्षित स्थान पर ले जाएँ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "شخص کو گرم، خشک اور محفوظ جگہ لے جائیں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆளை வெப்பமான, உலர்ந்த, பாதுகாப்பான இடத்திற்குக் கொண்டுசெல்லவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తిని వేడైన, పొడి, సురక్షితమైన స్థానానికి తీసుకెళ్ళండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Multimodal, 128K context, text and image input.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাল্টিমোডাল, 128K প্রসঙ্গ, টেক্সট ও ছবি ইনপুট।"
          }
