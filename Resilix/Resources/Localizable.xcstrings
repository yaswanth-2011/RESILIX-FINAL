        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செய்தி காலாவதியை இயக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సందేశ గడువు ప్రారంభించండి"
