            "value": "नया संदेश लिखें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ಸಂದೇಶ ಬರೆಯಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ സന്ദേശം എഴുതുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नया संदेश लिखें"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਵੀਂ ਸੁਨੇਹਾ ਲਿਖੋ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய செய்தி எழுதவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త సందేశం రాయండి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیا پیغام لکھیں"
          }
        }
