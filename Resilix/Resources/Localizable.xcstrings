            "value": "অনুমতির জন্য সিস্টেম সেটিংস খুলুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings for permissions"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનુમતિ માટે સિસ્ટમ સેટિંગ્સ ખોલો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति के लिए सिस्टम सेटिंग्स खोलें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿಗಳಿಗಾಗಿ ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അനുമതികൾക്കായി സിസ്റ്റം ക്രമീകരണങ്ങൾ തുറക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति के लिए सिस्टम सेटिंग्स खोलें"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਜਾਜ਼ਤਾਂ ਲਈ ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுமதிகளுக்கான அமைப்புகளைத் திறக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనుమతుల కోసం సిస్టమ్ సెట్టింగ్‌లు తెరవండి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت کے لیے سسٹم سیٹنگز کھولیں"
          }
        }
      }
    },
