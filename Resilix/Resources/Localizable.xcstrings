    "Bluetooth send queue is full for %@": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এর জন্য ব্লুটুথ পাঠানোর সারি পূর্ণ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth send queue is full for %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માટે બ્લૂટૂથ મોકલવાની કતાર ભરાઈ ગઈ છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए ब्लूटूथ भेजने की कतार भरी है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗಾಗಿ ಬ್ಲೂಟೂತ್ ಕಳುಹಿಸುವ ಸರದಿ ತುಂಬಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നതിനുള്ള ബ്ലൂടൂത്ത് അയയ്ക്കൽ ക്യൂ നിറഞ്ഞു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी ब्लूटूथ पाठवण्याची रांग भरली आहे"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਬਲੂਟੂਥ ਭੇਜਣ ਦੀ ਕਤਾਰ ਭਰ ਗਈ ਹੈ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கான புளூடூத் அனுப்பும் வரிசை நிரம்பியுள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం బ్లూటూత్ పంపే క్యూ నిండింది"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے لیے بلوٹوتھ بھیجنے کی قطار بھری ہوئی ہے"
          }
        }
      }
    },
