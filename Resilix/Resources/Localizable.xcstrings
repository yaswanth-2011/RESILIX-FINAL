    "Location only shared with consent, minimum precision.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান কেবল সম্মতি সহ, সর্বনিম্ন নির্ভুলতায় ভাগ করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location only shared with consent, minimum precision."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાન ફક્ત સંમતિ સાથે, ઓછામાં ઓછી ચોકસાઈ સાથે શેર થાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान केवल सहमति से, न्यूनतम सटीकता के साथ साझा किया जाता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳವನ್ನು ಸಮ್ಮತಿಯೊಂದಿಗೆ ಮಾತ್ರ ಕಡಿಮೆ ನಿಖರತೆಯೊಂದಿಗೆ ಹಂಚಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥാനം സമ്മതിയോടെ മാത്രം, കുറഞ്ഞ ക്രമമായി പങ്കിടുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान केवल सहमति से, न्यूनतम सटीकता के साथ साझा किया जाता है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਿਕਾਣਾ ਸਿਰਫ਼ ਸਹਿਮਤੀ ਨਾਲ, ਘੱਟੋ-ਘੱਟ ਸ਼ੁੱਧਤਾ ਨਾਲ ਸਾਂਝਾ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிடம் சம்மதியுடன் மட்டுமே, குறைந்த துல்லியத்துடன் பகிரப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానం సమ్మతితో మాత్రమే, కనీసం ఖచ్చితత్వంతో పంచుకుంటుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام صرف رضامندی کے ساتھ، کم از کم درستگی کے ساتھ شیئر ہوتا ہے۔"
          }
        }
      }
    },
    "Location sharing": {
