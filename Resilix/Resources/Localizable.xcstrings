    "The FoundationModels framework is not part of this build (iOS 26 SDK required).": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "FoundationModels ফ্রেমওয়ার্ক এই বিল্ডে নেই (iOS 26 SDK প্রয়োজন)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The FoundationModels framework is not part of this build (iOS 26 SDK required)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "FoundationModels ફ્રેમવર્ક આ બિલ્ડમાં સમાવિતો નથી (iOS 26 SDK જરૂરી)."
