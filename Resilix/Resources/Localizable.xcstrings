    "Critical severity with %@ - prioritized for immediate relay.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ সহ গুরুতর তীব্রতা - তাৎক্ষণিক রিলের জন্য অগ্রাধিকার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical severity with %@ - prioritized for immediate relay."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સાથે ગંભીર તીવ્રતા - તાત્કાલિક રિલે માટે પ્રાથમિકતા."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के साथ गंभीर गंभीरता - तत्काल रीले के लिए प्राथमिकता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಜೊತೆ ಗಂಭೀರ ತೀವ್ರತೆ - ತಕ್ಷಣ ರಿಲೇಗೆ ಪ್ರಾಧಾನ್ಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഉള്ള ഗുരുതരമായ സ്ഥിതി - ഉടൻ റിലേ ചെയ്യാൻ മുൻഗണന."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के साथ गंभीर गंभीरता - तुरंत रीले के लिए प्राथमिकता।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے ساتھ شدید شدت - فوری ریلے کے لیے ترجیح۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உடன் தீவிர நிலை - உடனே ரிலே செய்வதற்கு முன்னுரிமை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ తో తీవ్రమైన తీవ్రత - వెంటనే రిలే కోసం ప్రాధమ్యం."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے ساتھ شدید شدت - فوری ریلے کے لیے ترجیح۔"
          }
        }
      }
    },
    "Curated offline content, not a language model.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত অফলাইন বিষয়বস্তু, ভাষা মডেল নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curated offline content, not a language model."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલી ઑફલાઇન સામગ્રી, ભાષા મોડેલ નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी हुई ऑफ़लाइन सामग्री, भाषा मॉडल नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ದ ಆಫ್‌ಲೈನ್ ವಿಷಯ, ಭಾಷಾ ಮಾದರಿ ಅಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഓഫ്‌ലൈൻ ഉള്ളടക്കം, ഭാഷാ മോഡൽ അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडक ऑफलाइन सामग्री, भाषा मॉडेल नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀ ਹੋਈ ਔਫਲਾਈਨ ਸਮਗਰੀ, ਭਾਸ਼ਾ ਮਾਡਲ ਨਹੀਂ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட ஆஃப்லைன் உள்ளடக்கம், மொழி மாடல் அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంపిక చేసిన ఆఫ్‌లైన్ కంటెంట్, భాషా మోడల్ కాదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب آف لائن مواد، زبان ماڈل نہیں۔"
          }
        }
      }
    },
