    "Transport unavailable: %@. Check Bluetooth and local network permissions.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপোর্ট অনুপলব্ধ: %@. ব্লুটুথ ও স্থানীয় নেটওয়ার্ক অনুমতি পরীক্ষা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport unavailable: %@. Check Bluetooth and local network permissions."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાન્સપોર્ટ ઉપલબ્ધ નથી: %@. બ્લૂથ અને સ્થાનિક નેટવર્ક પરવાનગીઓ તપાસો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसपोर्ट उपलब्ध नहीं: %@। ब्लूटूथ और स्थानीय नेटवर्क अनुमतियाँ जाँचें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರಾನ್‌ಪೋರ್ಟ್ ಲಭ್ಯವಿಲ್ಲ: %@. ಬ್ಲೂಟೂತ್ ಮತ್ತು ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാൻസ്പോർട്ട് ലഭ്യമല്ല: %@. ബ്ലൂട്ടൂത്ത്, ലോക്കൽ നെറ്റ്‌വർക്ക് അനുമതികൾ പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वाहतूक उपलब्ध नाही: %@. ब्लूथ आणि स्थानिक नेटवर्क परवानग्या तपासा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਂਸਪੋਰਟ ਉਪਲਬਧ ਨਹੀਂ: %@. ਬਲੂਥ ਅਤੇ ਲੋਕਲ ਨੈੱਟਵਰਕ ਇਜਾਜ਼ਤਾਂ ਜਾਂਚੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆற்றல் கிடைக்கவில்லை: %@. பிளூடூத் மற்றும் உள்ளூர் நெட்வர்க் அனுமதிகளைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాన్స్‌పోర్ట్ అందుబాటులో లేదు: %@. బ్లూటూత్, లోకల్ నెట్‌వర్క్ అనుమతులు పరిశీలించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
