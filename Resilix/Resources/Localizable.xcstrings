    "Community reports are marked as unverified until verified by rescue role in demo. Do not assume unverified locations are safe.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেমোতে রেসকিউ ভূমিকা যাচাই করার আগে কমিউনিটি রিপোর্ট অযাচাইকৃত থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community reports are marked as unverified until verified by rescue role in demo. Do not assume unverified locations are safe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડેમોમાં રેસ્ક્યૂ ભૂમિકા દ્વારા ચકાસાય ત્યાં સુધી સમુદાય રિપોર્ટ અસત્યાપિત રહે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेमो में रेस्क्यू भूमिका द्वारा सत्यापित होने तक समुदाय रिपोर्ट असत्यापित रहती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೆಮೋದಲ್ಲಿ ರೆಸ್ಕ್ಯೂ ಪಾತ್ರದಿಂದ ಪರಿಶೀಲಿಸಲಾಗುವವರೆಗೆ ಸಮುದಾಯ ವರದಿಗಳನ್ನು ಪರಿಶೀಲಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡെമോയിൽ രെസ്ക്യൂ പങ്കാളികളും പരിശോധിക്കുന്നതുവരെ സമൂഹ റിപ്പോർട്ടുകൾ പരിശോധിച്ചിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डेमो में रेस्क्यू भूमिका द्वारा सत्यापित होने तक समुदाय रिपोर्ट असत्यापित रहती है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੈਮੋ ਵਿੱਚ ਰੈਸਕਿਊ ਭੂਮਿਕਾ ਦੁਆਰਾ ਪ੍ਰਮਾਣਿਤ ਹੋਣ ਤੱਕ ਭਾਈਚਾਰਾ ਰਿਪੋਰਟ ਅਗਿਆਮਿਤ ਰਹਿੰਦੀ ਹੈ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெமோவில் மீட்புப் பங்கு உறுதிப்படுத்தும் வரை சமூக அறிக்கைகள் சரிபார்க்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెమోలో రెస్క్యూ పాత్ర ద్వారా ధృవీకరించబడే వరకు సముదాయ నివేదికలు ధృవీకరించబడలేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیمو میں ریسکیو کردار کی تصدیق تک کمیونٹی رپورٹ غیر تصدیق شدہ رہتی ہے۔"
          }
        }
      }
    },
