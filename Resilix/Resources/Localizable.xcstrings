    "Call for help or send someone to fetch an AED if available.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাহায্য চান বা AED থাকলে কাউকে সেটি আনতে পাঠান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call for help or send someone to fetch an AED if available."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મદદ માંગો અથવા AED હોય તો કોઈને તે લાવવા મોકલો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मदद बुलाएँ या उपलब्ध हो तो किसी को AED लाने भेजें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಹಾಯ ಕರಿ ಅಥವಾ ಲಭ್ಯವಿದ್ದರೆ AED ತರಲು ಯಾರನ್ನಾದರೂ ಕಳುಹಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സഹായം വിളിക്കുക അല്ലെങ്കിൽ AED കൊണ്ടുവരാൻ ആരെങ്കിലും അയയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मदद बुलाएँ या उपलब्ध हो तो किसी को AED लाने भेजें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਦਦ ਮੰਗੋ ਜਾਂ AED ਉਪਲਬਧ ਹੋਵੇ ਤਾਂ ਕਿਸੇ ਨੂੰ ਇਹ ਲਾਉਣ ਭੇਜੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உதவியை அழைக்கவும் அல்லது கிடைத்தால் AED கொண்டு வர யாரையோ அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సహాయం అడగండి లేదా అందుబాటులో ఉంటే AED తేవడానికి ఎవరినైనా పంపండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مدد مانگیں یا AED دستیاب ہو تو کسی کو اسے لانے بھیجیں۔"
          }
        }
      }
    },
