    "Come to our location — water and food available": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের জায়গায় আসুন — পানি ও খাবার আছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come to our location — water and food available"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આમારા સ્થળે આવો — પાણી અને ભોજન ઉપલબ્ધ છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारे स्थान पर आएँ — पानी और भोजन उपलब्ध है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮ್ಮ ಸ್ಥಳಕ್ಕೆ ಬಂದು — ನೀರು, ಆಹಾರ ಲಭ್ಯವಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങളുടെ സ്ഥലത്തിലേക്ക് വരുക — വെള്ളിയും ഭക്ഷണവും ഉണ്ട്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आमच्या ठिकाणी या — पाणी आणि अन्न उपलब्ध आहे"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਰੇ ਸਥਾਨ 'ਤੇ ਆਓ — ਪਾਣੀ ਅਤੇ ਭੋਜਨ ਉਪਲਬਧ ਹੈ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்கள் இடத்திற்கு வாருங்கள் — நீர், உணவு உள்ளன"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మా స్థానానికి రండి — నీరు, ఆహారం అందుబాటులో ఉన్నాయి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمارے مقام پر آئیں — پانی اور کھانا دستیاب ہے"
          }
        }
      }
    },
