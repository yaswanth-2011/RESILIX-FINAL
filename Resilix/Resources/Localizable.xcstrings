        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "7ನೇ ಸೆಕ್ಟರ್‌ನಿಂದ ಸುರಕ್ಷತಾ ಸಂದೇಶ ಬಂದಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "7-ാം സെക്ടറിൽ നിന്ന് സുരക്ഷാ സിഗ്നൽ ലഭിച്ചു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेक्टर 7 मधून सुरक्षा संकेत मिळाला"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਕਟਰ 7 ਤੋਂ ਸੁਰੱਖਿਆ ਸੰਦੇਸ਼ ਮਿਲਿਆ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "7ஆம் செக்டரிலிருந்து பாதுகாப்பு செய்தி வந்தது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "7వ సెక్టర్ నుండి సేఫ్‌టీ సిగ్నల్ వచ్చింది"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیکٹر 7 سے حفاظتی اشارہ موصول ہوا"
          }
        }
      }
    },
