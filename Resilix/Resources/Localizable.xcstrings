    "Maintain continuous pressure for at least 10 minutes without lifting the cloth.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাপড় তুলে না ছাড়াই অন্তত ১০ মিনিট ধরে টানা চাপ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain continuous pressure for at least 10 minutes without lifting the cloth."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કપડું ઉપાડ્યા વગર ઓછામાં ઓછા 10 મિનિટ સુધી સતત દબાણ રાખો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कपड़ा उठाए बिना कम से कम 10 मिनट तक लगातार दबाव बनाए रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗೆರೆಯನ್ನು ಎತ್ತದೆ ಕನಿಷ್ಠ 10 ನಿಮಿಷ ನಿರಂತರ ಒತ್ತಡ ಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുക്ക് എടുക്കാതെ കുറഞ്ഞത് 10 മിനിറ്റ് തുടർച്ചിരിക്കും അമർത്തും പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कपड़ा उठाए बिना कम से कम 10 मिनट तक लगातार दबाव बनाए रखें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੱਪੜਾ ਉਠਾਏ ਬਿਨਾਂ ਘੱਟੋ-ਘੱਟ 10 ਮਿੰਟ ਤੱਕ ਲਗਾਤਾਰ ਦਬਾਅ ਰੱਖੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துணியை எடுக்காமல் குறைந்தது 10 நிமிடங்கள் தொடர்ச்சியாக அழுத்தம் போடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దుడ్డిని ఎత్తకుండా కనీసం 10 నిమిషాల పాటు నిరంతర ఒత్తిడి కొనసాగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کپڑا اٹھائے بغیر کم از کم 10 منٹ تک مسلسل دباؤ برقرار رکھیں۔"
          }
        }
      }
    },
