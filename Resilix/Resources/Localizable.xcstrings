    "assist.notMedicalAdvice": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নির্দেশনাটি পেশাদার চিকিৎসার বিকল্প নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guidance does not replace professional medical advice."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ માર્ગદર્શન વૃત્તિ તબીબીનો વિકલ્પ નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मार्गदर्शिका पेशेवर चिकित्सा का विकल्प नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಮಾರ್ಗದರ್ಶನವು ವೃತ್ತಿ ಚಿಕಿತ್ಸೆಗೆ ಪರ್ಯಾಯವಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാർഗരേഖ പ്രൊഫഷണൽ ചികിത്സയ്ക്ക് പകരം അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा मार्गदर्शन व्यावसायिक वैद्यकीय उपचाराचा पर्याय नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਮਾਰਗਦਰਸ਼ਨ ਪੇਸ਼ੇਦਾਰ ਡਾਕਟਰੀ ਦਾ ਬਦਲਾ ਨਹੀਂ ਹੈ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழிகாட்டல் வ மருத்துவக்கு மாற்றாகாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ మార్గదర్శకం వృత్తి వైద్యానికి ప్రత్యామ్నాయం కాదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ رہنمائی پیشہ ور طبی نگہداشت کا متبادل نہیں ہے۔"
          }
        }
      }
    },
