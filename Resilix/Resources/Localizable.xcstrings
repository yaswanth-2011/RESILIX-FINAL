    "Apple Foundation Models require iOS 26 or later.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models-এর জন্য iOS 26 বা তার বেশি দরকার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models require iOS 26 or later."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models માટે iOS 26 અથવા તેથી નવું જોઈએ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models के लिए iOS 26 या उससे नया चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models ಗೆ iOS 26 ಅಥವಾ ಅದಕ್ಕಿಂತ ಹೆಚ್ಚು ಬೇಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models-ന് iOS 26 അല്ലെങ്കിൽ അതിനു ശേഷം വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models साठी iOS 26 किंवा त्यापेक्षा नवीन आवश्यक."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models ਲਈ iOS 26 ਜਾਂ ਇਸ ਤੋਂ ਨਵਾਂ ਲੋੜੀਂਦਾ ਹੈ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models கு iOS 26 அல்லது அதற்கு பிறகு தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models కోసం iOS 26 లేదా అంతకంటే కొత్తది అవసరం."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models کے لیے iOS 26 یا اس سے نیا درکار ہے۔"
          }
        }
      }
    },
