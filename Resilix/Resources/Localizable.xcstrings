    "No offline entry matches “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” এর সাথে মেলে এমন অফলাইন এন্ট্রি নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offline entry matches “%@”."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” સાથે મેળ ખાતો ઑફલાઇન એન્ટ્રી નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऑफ़लाइन प्रविष्टि “%@” से मेल नहीं खाती।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಜೊತೆಗೆ ಹೊಂದುವ ಆಫ್‌ಲೈನ್ ನಮೂನೆ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” എന്നതിനൊപ്പം ബന്ധപ്പെടുന്ന ഓഫ്‌ലൈൻ നമൂനവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” शी जुळणारा ऑफलाइन नोंदी नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਨਾਲ ਮਿਲਦਾ ਔਫਲਾਈਨ ਐਂਟਰੀ ਨਹੀਂ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” உடன் பொருந்தும் ஆஃப்லைன் பதிவு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” కు సరిపోలేని ఆఫ్‌లైన్ నమూనా లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” سے مطابقت رکھنے والا آف لائن اندراج نہیں۔"
          }
        }
      }
    },
    "No offline map installed": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অফলাইন মানচিত্র ইনস্টল নেই"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offline map installed"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ ઓફલાઇન નકશો ઇન્સ્ટોલ કરેલો નથી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऑफ़लाइन मैप इंस्टॉल नहीं है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್‌ಲೈನ್ ನಕ್ಷೆ ಅನ್‌ಸ್ಟಾಲ್ ಮಾಡಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ്‌ലൈൻ ഭൂട്ടം ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऑफ़लाइन मैप इंस्टॉल नहीं है"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਆਫਲਾਈਨ ਨਕਸ਼ਾ ਇੰਸਟਾਲ ਨਹੀਂ ਕੀਤਾ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆஃப்லைன் வரைபடம் நிறுவப்படவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్ మ్యాప్ ఇన్‌స్టాల్ చేయలేదు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آف لائن نقشہ انسٹال نہیں"
          }
        }
      }
    },
    "No offline map is installed. The map screen uses the online Apple tiles until a pack is imported.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অফলাইন মানচিত্র ইনস্টল করা নেই। প্যাক ইমপোর্ট না হওয়া পর্যন্ত মানচিত্র স্ক্রিন অনলাইন Apple টাইল ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No offline map is installed. The map screen uses the online Apple tiles until a pack is imported."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ ઓફલાઇન નકશો ઇન્સ્ટોલ કરેલો નથી. પેક આયાત થાય ત્યાં સુધી નકશો સ્ક્રીન ઓનલાઇન Apple ટાઇલ્સ વાપરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऑफ़लाइन मैप इंस्टॉल नहीं है। पैक आयात होने तक मैप स्क्रीन ऑनलाइन Apple टाइल्स का उपयोग करती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್‌ಲೈನ್ ನಕ್ಷೆ ಸ್ಥಾಪಿಸಿಲ್ಲಿಲ್ಲ. ಪ್ಯಾಕ್ ಆಮದು ಮಾಡುವವರೆಗೆ ನಕ್ಷೆ ಸ್ಕ್ರೀನ್ ಆನ್‌ಲೈನ್ Apple ಟೈಲ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ്‌ലൈൻ മാപ്പ് സ്ഥാപിച്ചിട്ടില്ല. പാക്ക് ഇറക്കുമതി ചെയ്യുന്നതുവരെ മാപ്പ് സ്ക്രീൻ ഓൺലൈൻ Apple ടൈലുകൾ ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऑफ़लाइन मैप इंस्टॉल नहीं है। पैक आयात होने तक मैप स्क्रीन ऑनलाइन Apple टाइल्स का उपयोग करती है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਆਫਲਾਈਨ ਨਕਸ਼ਾ ਇੰਸਟਾਲ ਨਹੀਂ ਹੈ। ਪੈਕ ਆਯਾਤ ਹੋਣ ਤੱਕ ਨਕਸ਼ਾ ਸਕ੍ਰੀਨ ਆਨਲਾਈਨ Apple ਟਾਈਲਾਂ ਵਰਤਦੀ ਹੈ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆஃப்லைன் வரைபடம் நிறுவப்படவில்லை. தொகுப்பு இறக்குமதி செய்வதன் முன் வரைபடத் திரை ஆன்லைன் Apple டைல்களைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్ మ్యాప్ ఇన్‌స్టాల్ చేయలేదు. ప్యాక్ ఇంపోర్ట్ చేసే వరకు మ్యాప్ స్క్రీన్ ఆన్‌లైన్ Apple టైల్స్ ఉపయోగిస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آف لائن نقشہ انسٹال نہیں ہوا۔ پیک درآمد ہونے تک نقشہ اسکرین آن لائن Apple ٹائل استعمال کرتی ہے۔"
          }
        }
      }
    },
    "No peer is connected yet — scan for devices first.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো পিয়ার সংযুক্ত নেই — আগে ডিভাইস স্ক্যান করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No peer is connected yet — scan for devices first."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી કોઈ પિયર જોડાયું નથી — પહેલા ડિવાઇસ શોધો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई पीयर जुड़ा नहीं है — पहले डिवाइस खोजें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಯಾವುದೇ ಪೀರ್ ಸಂಪರ್ಕಿತವಿಲ್ಲ — ಮೊದಲು ಸಾಧನಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ പീയർ ഒരുമ്പോ ബന്ധിച്ചിട്ടില്ല — ആദ്യം ഉപകരണങ്ങൾ സ്കാൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई पीयर जुड़ा नहीं है — पहले डिवाइस खोजें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਕੋਈ ਪਿਆਰ ਜੁੜਿਆ ਨਹੀਂ — ਪਹਿਲਾਂ ਡੀਵਾਈਸ ਲੱਭੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் எந்த பியரும் இணைக்கப்படவில்லை — முதலில் சாதனங்களைத் தேடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఏ పీర్ కనెక్ట్ కాలేదు — ముందుగా పరికరాలు స్కాన్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی پیئر منسلک نہیں — پہلے ڈیوائسز تلاش کریں۔"
          }
        }
      }
    },
