    "P2P Wi-Fi uses local network discovery. Denied limits peer discovery.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi স্থানীয় নেটওয়ার্ক আবিষ্কার ব্যবহার করে। অনুমতি না দিলে পিয়ার আবিষ্কার সীমিত থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi uses local network discovery. Denied limits peer discovery."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi સ્થાનિક નેટવર્ક શોધવાનો ઉપયોગ કરે છે. નિષેધ થશે તો પિયર શોધ મર્યાદિત રહેશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi स्थानीय नेटवर्क खोज का उपयोग करता है। अनुमति न होने पर पीयर खोज सीमित रहती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್ ಅನ್ವೇಷಣೆಯನ್ನು ಬಳಸುತ್ತದೆ. ನಿರಾಕರಿಸಿದರೆ ಪೀರ್ ಅನ್ವೇಷಣೆ ಮಿತಿಬದ್ಧವಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi ലോക്കൽ നെറ്റ്‌വർക്ക് കണ്ടെത്തൽ ഉപയോഗിക്കുന്നു. നിഷേധിച്ചാൽ പീയർ കണ്ടെത്തൽ പരിമിതിയാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi स्थानीय नेटवर्क खोज का उपयोग करता है। अनुमति न होने पर पीयर खोज सीमित रहती है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi ਸਥਿਆਈ ਨੈੱਟਵਰਕ ਖੋਜ ਵਰਤਦਾ ਹੈ। ਇਨਕਾਰ ਹੋਵੇ 'ਤੇ ਪਿਆਰ ਖੋਜ ਸੀਮਿਤ ਰਹੇਗੀ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi உள்ளூர் நெட்வர்க் கண்டுபிடிப்பைப் பயன்படுத்துகிறது. மறுக்கப்பட்டால் பியர் கண்டுபிடிப்பு கட்டுப்படுத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi లోకల్ నెట్‌వర్క్ అన్వేషణను ఉపయోగిస్తుంది. నిరాకరించినట్లయితే పీర్ అన్వేషణ పరిమితంగా ఉంటుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Wi-Fi مقامی نیٹ ورک کی تلاش استعمال کرتا ہے۔ اجازت نہ دی جائے تو پیئر تلاش محدود رہے گی۔"
          }
        }
      }
    },
