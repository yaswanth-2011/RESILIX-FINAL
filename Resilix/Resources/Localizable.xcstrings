    "Give 2 rescue breaths after 30 compressions if you are trained.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশিক্ষিত হলে ৩০টি কম্প্রেশনের পর ২টি রেসকিউ ব্রেথ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give 2 rescue breaths after 30 compressions if you are trained."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તરબીત હોય તો 30 દબાણ પછી 2 રિસ્ક્યુ શ્વાસ આપો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि प्रशिक्षित हैं, तो 30 दबाव के बाद 2 बचाव श्वास दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತರಬೇತಿ ಪಡೆದಿದ್ದರೆ 30 ಒತ್ತಡಗಳ ನಂತರ 2 ಉಪಲಾಧ ಉಸಿರುಗಳನ್ನು ನೀಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശീലനം നേടിയവരായാല് 30 അമർത്തലുകൾക്ക് ശേഷം 2 രക്ഷണ ശ്വാസങ്ങൾ നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि प्रशिक्षित हैं, तो 30 दबाव के बाद 2 बचाव श्वास दें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਸਿਖਲੇ ਹੋ ਤਾਂ 30 ਦਬਾਅ ਬਾਅਦ 2 ਬਚਾਅ ਸਾਹ ਦਿਓ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயிற்சி பெற்றிருந்தால் 30 அமுக்கங்களுக்குப் பிறகு 2 மீட்பு மூச்சுகள் அளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శిక్షణ పొందివున్నట్లయితే 30 ఒత్తిడుల తర్వాత 2 పునర్జీవన శ్వాసాలు ఇవ్వండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تربیت یافتہ ہیں تو 30 دباؤ کے بعد 2 بچاؤ شونگیں دیں۔"
          }
        }
      }
    },
    "Give 5 abdominal thrusts (Heimlich maneuver).": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৫ বার পেটে জোরে চাপ দিন (হেইমলিচ পদ্ধতি)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give 5 abdominal thrusts (Heimlich maneuver)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "5 વાર પેટ પર જોરથી થપકો (હાઇમ્લિક પદ્ધતિ)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 पेट पर ज़ोर से थपकी दें (हाइमलिक तकनीक)।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ಉದರ ಒತ್ತಡಗಳನ್ನು ನೀಡಿ (ಹೈಮ್ಲಿಕ್ ಕ್ರಮ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "5 വയറ്റിലെ അമർത്തലുകൾ നൽകുക (ഹൈംലിക് മെഥഡ്)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 पेट पर ज़ोर से थपकी दें (हाइमलिक तकनीक)।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ਵਾਰ ਪੇਟ 'ਤੇ ਜ਼ੋਰ ਨਾਲ ਥਪਕੋ (ਹਾਈਮਲਿਕ ਤਰੀਕਾ)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "5 வயிற்றுப் பகுதி அமுக்கங்கள் (ஹைம்லிச் முறை) வழங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ఉదర ఒత్తిడ్లు ఇవ్వండి (హైమ్లిక్ పద్ధతి)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "5 بار شکم پر زور سے دباؤ دیں (ہیملک طریقہ)۔"
          }
        }
      }
    },
    "Give 5 firm back blows between the shoulder blades.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘাঁটার হাড়ের মাঝে ৫ বার জোরে পিঠে চাপড় দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give 5 firm back blows between the shoulder blades."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંધની હાડકી વચ્ચે 5 વાર જોરથી પીઠ પાડો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंधों की हड्डियों के बीच 5 ज़ोर से थपकी दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಭುಜದ ಎಲ್ಮುಗಳ ನಡುವೆ 5 ಗಟ್ಟಿಯಾಗಿ ಹಿಂಬಿನ ತಟ್ಟುಗಳನ್ನು ಕೊಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തോള് എലുമ്പുകൾക്കിടയിൽ 5 ശക്തമായ പിന്നിലുള്ള അടിപ്പറപ്പുകൾ നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंधों की हड्डियों के बीच 5 ज़ोर से थपकी दें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਧਿਆਂ ਦੀਆਂ ਹੱਡੀਆਂ ਵਿਚਕਾਰ 5 ਵਾਰ ਜ਼ੋਰ ਨਾਲ ਪਿੱਠ 'ਤੇ ਥਪਕੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள் எலும்புகளுக்கு இடையில் 5 தடித்த முதுகுத் தட்டுகள் வழங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజం ఎముకల మధ్య 5 బలంగా వెనుక కొట్టండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کندھوں کی ہڈیوں کے درمیان 5 بار زور سے پیٹ پر تھپکار دیں۔"
          }
        }
      }
    },
    "Give me emergency steps for a burn.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোড়ার জন্য জরুরি পদক্ষেপ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me emergency steps for a burn."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બળામાં માટે કટોકટીના પગલાં આપો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जलन के लिए आपातकालीन कदम बताएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುಟ್ಟುವಿಕೆಗೆ ತುರ್ತಕಾಲದ ಹಂತಗಳನ್ನು ನೀಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൊരുമ്പിന് അടിയണ നടക്കലുകൾ തരുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जळण्यासाठी आणीबाणीच्या पायऱ्या द्या."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਲਣ ਲਈ ਐਮਰਜੈਂਸੀ ਕਦਮ ਦਿਓ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காயத்திற்கான அவசர நடவடிக்கைகளைத் தரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంటువడానికి అత్యవసర దశలు ఇవ్వండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلنے کے لیے ہنگامی اقدامات بتائیں۔"
          }
        }
      }
    },
    "Give warm (not hot) sweet drinks if fully conscious.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ সচেতন হলে উষ্ণ (অতিরিক্ত গরম নয়) মিষ্টি পানীয় দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give warm (not hot) sweet drinks if fully conscious."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંપૂર્ણ ચેતનાવસ્થામાં હોય તો ગરમ (વધુ ગગમ નહીં) મધુર પાણી આપો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी चेतना होने पर गर्म (गरम नहीं) मीठा पेय दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪೂರ್ಣ ಜ್ಞಾನವಂತವರಿಗೆ ಬೆಚ್ಚಗಿನ (ತುಂಬಾ ಬೆಚ್ಚಗಿನ ಅಲ್ಲ) ಸಿಹಿ ಪಾನೀಯ ಕೊಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർണ്ണ ബോധമുള്ളവർക്ക് ചൂടുള്ള (വളരെ ചൂടുള്ളതല്ല) ഇനിയ പാനീയം നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी चेतना होने पर गर्म (गरम नहीं) मीठा पेय दें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر مکمل ہوشیار ہوں تو گرم (بہت گرم نہیں) میٹھا پانی دیں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழுமையாக உணர்வுள்ளவராக இருந்தால் வெப்பமான (அதிக வெப்பமில்லாத) இனிப்பு குடிப்புகள் கொடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి స్పృహగా ఉంటే వేడి (బాగా వేడి కాకుండా) మీటిని పానీ ఇవ్వండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Handle gently; rough movement can trigger irregular heartbeat.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলতোভাবে ধরুন; জোরে নাড়ালে অনিয়মিত হৃদস্পন্দন হতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle gently; rough movement can trigger irregular heartbeat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ધીરે સંભાલો; જોરથી હલાવવાથી અસમ ધડકન થઈ શકે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से संभालें; ज़ोर से हिलाने से अनियमित धड़कन हो सकती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೃದುವಾಗಿ ನಿರ್ವಹಿಸಿ; ಕಠಿಣವಾಗಿ ಚಲಿಸಿದರೆ ಅಸಮ ಹೃದಯಬಿಡ ಸಂವಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നല്ലായി കൈകൊണ്ടുകാരുക; കഠിണമായി നീക്കുമ്പോൾ അന്യയമായ ഹൃദയമിടിപ്പ് ഉണ്ടാകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे से संभालें; ज़ोर से हिलाने से अनियमित धड़कन हो सकती है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "نرمی سے پکڑیں؛ زور سے ہلاने سے بے ترتیب دل کی دھڑکن ہو سکتی ہے۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மென்மையாகக் கொள்கவும்; கடுமையாக அசவாத்தால் ஒழுங்கற்ற இதயத் துடிப்பு ஏற்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మృదువుగా వ్యవహరించండి; తీవ్రంగా కదిలిస్తే అసమ స్పందన కలగొన్డై అవకాశం ఉంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
