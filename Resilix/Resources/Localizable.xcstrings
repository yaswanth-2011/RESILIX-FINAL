    "Help improve offline AI quality": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন AI-এর মান উন্নত করতে সাহায্য করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve offline AI quality"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઑફલાઇન AI ની ગુણવત્તા સુધારવામાં મદદ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन AI की गुणवत्ता सुधारने में मदद करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್‌ಲೈನ್ AI ಗುಣಮಟ್ಟವನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ്‌ലൈൻ AI നിലവാരം മെച്ചപ്പെടുത്താൻ സഹായിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफलाइन AI ची गुणवत्ता सुधारण्यास मदत करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਫਲਾਈਨ AI ਦੀ ਗੁਣਵੱਤਾ ਸੁਧਾਰਨ ਵਿੱਚ ਮਦਦ ਕਰੋ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆஃப்லைன் AI தரத்தை மேம்படுத்த உதவுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్ AI నాణ్యతను మెరుగుపరచడంలో సహాయపడండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن AI کے معیار بہتر بنانے میں مدد کریں۔"
          }
        }
      }
    },
    "High severity %@ requires prompt forwarding.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ উচ্চ গুরুতরতা দ্রুত ফরওয়ার্ড প্রয়োজন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High severity %@ requires prompt forwarding."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉચ્ચ તીવ્રતા %@ ને તરત આગળ મોકલવું જોઈએ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च गंभीरता %@ को तुरंत अग्रेषण चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತ ತೀವ್ರತೆ %@ ತಕ್ಷಣ ರಿಲೇ ಅಗತ್ಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "உயர் தீவிரம் %@ உடனே முன்னோக்கி அனுப்ப வேண்டும்."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च गंभीरता %@ को तुरंत आगे भेजना चाहिए।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਚ ਗੁਰੂਤਾ %@ ਨੂੰ ਤੁਰੰਤ ਅੱਗੇ ਭੇਜਣਾ ਚਾਹੀਦਾ ਹੈ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உயர் தீவிரம் %@ உடனே பரிமாற வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీవ్రమైన తీవ్రత %@ త్వరితంగా ముందుకు పంపాలి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کی شدید صورتحال کو جلدی آگے بھیجنا چاہیے۔"
          }
        }
      }
    },
    "Hold to send SOS": {
