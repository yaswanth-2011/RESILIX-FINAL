    "Message expired before delivery.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেলিভারির আগেই বার্তার সময়সীমা শেষ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message expired before delivery."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિલિવરી પહેલાં જ સંદેશની સમયમર્યાદા પૂરી થઈ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीवरी से पहले संदेश की समय-सीमा समाप्त हो गई।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿತರಣೆಗೂ ಮೊದಲು ಸಂದೇಶದ ಅವಧಿ ಮುಗಿದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡെലിവറിക്കും മുമ്പ് സന്ദേശത്തിന്റെ സമയപരിധി കഴിഞ്ഞു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वितरणापूर्वी संदेशाची मुदत संपली."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਲੀਵਰੀ ਤੋਂ ਪਹਿਲਾਂ ਹੀ ਸੁਨੇਹੇ ਦੀ ਮਿਆਦ ਪੁੱਗੀ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விநியோதனைக்கு முன் செய்தியின் கால அவதானம் முடிந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెలివరీకి ముందే సందేశం గడువు ముగిసింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیلیوری سے پہلے ہی پیغام کی میعاد ختم ہو گئی۔"
          }
        }
      }
    },
