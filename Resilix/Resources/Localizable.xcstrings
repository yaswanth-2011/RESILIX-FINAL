    "Delivery is reported only when the peer acknowledges the packet": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিয়ার প্যাকেট স্বীকৃতি দিলে কেবল ডেলিভারি রিপোর্ট হয়"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery is reported only when the peer acknowledges the packet"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પીયર પેકેટની પુષ્ટિ થાય પછી જ ડિલિવરી રિપોર્ટ થાય છે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीवरी तभी दर्ज होती है जब पीयर पैकेट की पुष्टि करे"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೀರ್ ಪ್ಯಾಕೆಟ್ ಅನುಮೋದಿಸಿದ ಸಮಯದಲ್ಲಿಮಾತ್ರ ಡೆಲಿವರಿ ವರದಿಯಾಗುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പീർ പാക്കറ്റ് സ്ഥിരീകരിക്കുമ്പോൾ മാത്രം ഡെലിവറി റിപ്പോർട്ട് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पीअरने पॅकेटची सत्यता कैली तरच डिलिव्हरी नोंदवली जाते"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੀਅਰ ਪੈਕਟ ਦੀ ਪੁਸ਼ਟੀ ਹੋਣ 'ਤੇ ਹੀ ਡਿਲੀਵਰੀ ਰਿਪੋਰਟ ਹੁੰਦੀ ਹੈ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அண்ணிற்கர் பாக்கெட் உறுதிப்படுத்தியபோதே டெலிவரி தெரிவிக்கப்படுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెలివరీ పీర్ ప్యాకెట్‌ను ధృవీకరించినప్పుడే నివేదించబడుతుంది"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیلیوری صرف اس وقت رپورٹ ہوتی ہے جب پیئر پیکٹ کی تصدیق کرے"
          }
        }
      }
    },
