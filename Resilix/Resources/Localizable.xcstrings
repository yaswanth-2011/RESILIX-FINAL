    "Where is the nearest shelter and hospital?": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিকটতম আশ্রয়স্থল ও হাসপাতাল কোথায়?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where is the nearest shelter and hospital?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નજીકનું આશ્રય અને દવાખાનું ક્યાં છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़दीकी आश्रय और अस्पताल कहाँ है?"
