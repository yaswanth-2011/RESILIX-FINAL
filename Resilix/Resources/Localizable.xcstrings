    "Forwarding queue is full. Try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফরওয়ার্ডিং সারি পূর্ণ। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forwarding queue is full. Try again shortly."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોર્વર્ડિંગ કતાર ભરાઈ છે. થોડી વારમાં ફરી પ્રયાસ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फॉरवर्डिंग कतार भर गई है। थोड़ी देर बाद प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದುವರಿಸುವ ಸರತಿ ತುಂಬಿದೆ. ಸ್ವಲ್ಪ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുന്നോട്ടുവിട്ടുന്ന ക്യൂ നിറഞ്ഞിരിക്കുന്നു. അല്പസമയത്തിനുള്ളി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फॉरवर्डिंग कतार भरली आहे. थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫੋਰਵਰਡਿੰਗ ਕਤਾਰ ਭਰ ਗਈ ਹੈ. ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்னோக்கி அனுப்பும் வரிசை நிறைந்துள்ளது. சிறிது நேரத்தில் மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫార్వర్డింగ్ క్యూ పూర్తిగా ఉంది. కొద్ది సేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فارورڈنگ قطاری بھری ہوئی ہے۔ کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        }
      }
    },
    "Found a working generator, sharing fuel at block D": {
