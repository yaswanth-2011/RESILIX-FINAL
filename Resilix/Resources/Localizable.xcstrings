    "Packet %@ handed to the simulated transport": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেট %@ সিমুলেটেড ট্রান্সপোর্টে হস্তান্তর করা হয়েছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packet %@ handed to the simulated transport"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેકેટ %@ સિમ્યુલેટેડ ટ્રાન્સપોર્ટને આપવામાં આવ્યું"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेट %@ सिम्युलेटेड ट्रांसपोर्ट को सौंपा गया"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೆಟ್ %@ ಸಿಮ್ಯುಲೇಟೆಡ್ ಟ್ರಾನ್ಸ್‌ಪೋರ್ಟ್‌ಗೆ ವಿಂಗಡಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ பாக்கெட் பின்னிமைப்பு ட்ரான்ஸ்போர்டிற்கு வழங்கப்பட்டது"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेट %@ सिम्युलेटेड ट्रान्सपोर्टला दिले"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕਟ %@ ਸਿਮੁਲੇਟਿਡ ਟ੍ਰਾਂਸਪੋਰਟ ਨੂੰ ਸੌਂਪਿਆ ਗਿਆ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாக்கெட் %@ பின்னிமைப்பு ட்ரான்ஸ்போர்டிற்கு வழங்கப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకెట్ %@ సిములేటెడ్ ట్రాన్స్‌పోర్ట్‌కు అప్పించబడింది"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکٹ %@ کو سیمولیٹڈ ٹرانسپورٹ کو دیا گیا"
          }
        }
      }
    },
    "Packet exceeds size limit.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেট আকার সীমা অতিক্রান্ত করেছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packet exceeds size limit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેકેટ કદ મર્યાદાને વીતી ગયું."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेट आकार सीमा से अधिक है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೆಟ್ ಗಾತ್ರದ ಮಿತಿ ಮೀರಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാക്കറ്റിന്റെ വലിപ്പം പരിധി കടത്തി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेट आकार मर्यादा ओलांडले."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕਟ ਆਕਾਰ ਹੱਦ ਨੂੰ ਪਾਰ ਗਿਆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாக்கெட் அளவு வரம்பைத் தாண்டியது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకెట్ పరిమాణ పరిమితిని మించింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکٹ کا حجم حد سے تجاوز ہو گیا۔"
          }
        }
      }
    },
    "Packet hop limit reached.": {
      "extractionState": "manual",
      "localizations": {
