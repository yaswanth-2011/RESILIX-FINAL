        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾರ್ವಜನಿಕ ಸಾರಿಗೆಯನ್ನು ಒತ್ತುಗೊಳಿಸುವ ನಕ್ಷೆ"
          }
