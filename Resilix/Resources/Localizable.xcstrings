        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS ದೃಢೀಕರಿಸಲು 1.5 ಸೆಕೆಂಡ್ ಒತ್ತಿ ಹಿಡಿಯಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS ഉറപ്പിക്കാൻ 1.5 സെക്കൻഡ് അമർത്തിപ്പിടിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एसओएस की पुष्टि के लिए 1.5 सेकंड तक देर तक दबाएँ"
