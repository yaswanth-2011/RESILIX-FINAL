    "How can I help?": {
      "comment": "A title for the empty state.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি কীভাবে সাহায্য করতে পারি?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How can I help?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું કેવી રીતે મદદ કરું?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं कैसे मदद कर सकता हूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಹೇಗೆ ಸಹಾಯ ಮಾಡಬಹುದು?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എങ്ങനെ സഹായിക്കാം?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी कसे मदत करू?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਕਿਵੇ ਮਦਦ ਕਰ ਸਕਾਂ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எப்படி உதவலாம்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను ఎలా సహాయం చేయగలను?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں کیسے مدد کر سکتا ہوں؟"
          }
        }
      }
    },
    "How do I treat a severe bleeding injury?": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গুরুতর রক্তস্রাবের আঘাত কীভাবে চিকিৎসা করব?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I treat a severe bleeding injury?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગંભીર રક્તસ્રાવની ઇજાત કેવી રીતે સારવી?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंभीर रक्तस्राव की चोट का उपचार कैसे करूँ?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೀವ್ರ ರಕ್ತಸ್ರಾವದ ಗಾಯವನ್ನು ಹೇಗೆ ಚಿಕಿತ್ಸಿಸುವುದು?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുരുതരമായ രക്തസ്രാവത്തെ എങ്ങനെ ചികിത്സിക്കും?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गंभीर रक्तस्रावाच्या जखमीचा उपचार कसा करावा?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੰਭੀਰ ਖੂਨ ਦੀ ਇਜਾਤ ਦਾ ਇਲਾਜ ਕਿਵੇਂ ਕਰੀਏ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீவிர குருதிச்செலவைக் குறிப்பாக எப்படிக் கட்டுப்படுத்துவது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీవ్ర రక్తస్రావ గాయాన్ని ఎలా చెలుగుతాము?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شدید خون کی زخم کا علاج کیسے کریں؟"
          }
        }
      }
    },
    "Hypothermia response": {
