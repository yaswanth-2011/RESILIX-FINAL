        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કામ કરતો જનરેટર મળ્યો, બ્લોક D પર ઇંધન શેર કરી રહ્યા"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू जनरेटर मिला, ब्लॉक डी में ईंधन साझा कर रहे हैं"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲಸ ಮಾಡುತ್ತಿರುವ ಜೆನರೇಟರ್ ಸಿಕ್ಕಿತು, ಬ್ಲಾಕ್ D ನಲ್ಲಿ ಇಂಧನ ಹಂಚಿಕೊಳ್ಳುತ್ತಿದ್ದೇವೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തിപ്പുന്ന ജനറേറ്റർ കണ്ടെത്തി, ബ്ലോക്ക് D-ലെ ഇന്ധനം പങ്കിടുക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू जनरेटर सापडला, ब्लॉक D वर इंधन सामायिक करतोय"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੱਲਦਾ ਜਨਰੇਟਰ ਮਿਲਿਆ, ਬਲਾਕ D 'ਤੇ ਬਾਲਣ ਸਾਂਝਾ ਰਹੇ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயங்கும் ஜெனரேட்டர் கிடைத்தது, திளகு D-இல் எரிபொருள் பகிர்கிறோம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పనిచేసే జనరేటర్ దొరికింది, బ్లాక్ Dలో ఇంధనం పంచుకుంటున్నాం"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چلتا ہوا جنریٹر ملا، بلاک D پر ایندھن شیئر کر رہے ہیں"
          }
        }
      }
    },
