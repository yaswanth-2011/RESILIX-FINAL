        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS ਦੀ ਪੁਸ਼ਟੀ ਲਈ 1.5 ਸਕਿੰਟ ਦਬਾ ਕੇ ਰੱਖੋ"
