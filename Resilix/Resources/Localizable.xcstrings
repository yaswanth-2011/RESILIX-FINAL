    "Can see: packet size, timing, source/destination IDs (for routing).": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখতে পারে: প্যাকেট আকার, সময়, উৎস/গন্তব্য আইডি (রাউটিংয়ের জন্য)।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can see: packet size, timing, source/destination IDs (for routing)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોઈ શકે છે: પેકેટ કદ, સમય, સ્રોત/લક્ષ્ય આઈડી (રૂટિંગ માટે)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देख सकता है: पैकेट आकार, समय, स्रोत/गंतव्य आईडी (रूटिंग के लिए)।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೋಡಬಹುದು: ಪ್ಯಾಕೆಟ್ ಗಾತ್ರ, ಸಮಯ, ಮೂಲ/ಗಮ್ಯ ಐಡಿ (ರೂಟಿಂಗ್‌ಗಾಗಿ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണാം: പാക്കറ്റ് വലിപ്പം, സമയം, ഉറവിടം/ലക്ഷ്യം ഐഡി (റൂട്ടിംഗിനായി)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "देख सकता है: पैकेट आकार, समय, स्रोत/गंतव्य आईडी (रूटिंग के लिए)।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੇਖ ਸਕਦਾ ਹੈ: ਪੈਕੇਟ ਆਕਾਰ, ਸਮਾਂ, ਸਰੋਤ/ਮੰਜ਼ਿਲ ਆਈਡੀ (ਰਾਊਟਿੰਗ ਲਈ)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காண முடியும்: பேக்கெட் அளவு, நேரம், மூலம்/இலக்கு ஐடி (வழிசெலுத்தலுக்காக)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చూడగలిస్తుంది: ప్యాకెట్ పరిమాణం, సమయం, మూల/గమ్య ఐడి (రూటింగ్ కోసం)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھ سکتا ہے: پیکٹ سائز، ٹائمنگ، ماخذ/منزل آئی ڈی (روٹنگ کے لیے)۔"
          }
        }
      }
    },
