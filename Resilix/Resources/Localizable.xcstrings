    "Cool the burn with clean, cool running water for at least 10 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোড়া জায়গা অন্তত ১০ মিনিট পরিষ্কার ঠান্ডা প্রবাহিত জলে ঠান্ডা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool the burn with clean, cool running water for at least 10 minutes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બળાવણાને ઓછામાં ઓછા 10 મિનિટ સ્વચ્છ ઠંડા વહેતા પાણીથી ઠાંડો કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जलन को कम से कम 10 मिनट तक साफ ठंडे बहते पानी से ठंडा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುಟ್ಟನ್ನು ಕನಿಷ್ಠ 10 ನಿಮಿಷ ಸ್ವಚ್ಛ ತಂಪು ಹರಿಯುವ ನೀರಿನಿಂದ ತಂಪಾಗಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കായം കുറഞ്ഞത് 10 മിനിറ്റ് ശുദ്ധവായ തണുത്ത ഒഴുന്ന വെള്ളിയുമായി തണുപ്പിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जलन को कम से कम 10 मिनट तक साफ ठंडे बहते पानी से ठंडा करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਲਣ ਨੂੰ ਘੱਟੋ-ਘੱਟ 10 ਮਿੰਟ ਸਾਫ਼ ਠੰਢੇ ਵਗਦੇ ਪਾਣੀ ਨਾਲ ਠੰਢਾ ਕਰੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காயத்தை குறைந்தது 10 நிமிடங்கள் சுத்தமான குளிர்ந்த ஓடும் நீரால் குளிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాతను కనీసం 10 నిమిషాల పాటు స్వచ్ఛమైన చల్లని ప్రవాహ నీటితో చల్లించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلگی کو کم از کم 10 منٹ صاف ٹھنڈے بہتے پانی سے ٹھنڈا کریں۔"
          }
        }
      }
    },
