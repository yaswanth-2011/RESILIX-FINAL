    "Safety guide for staying in place during an emergency.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জরুরি অবস্থায় এক জায়গায় থাকার নিরাপত্তা নির্দেশিকা."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety guide for staying in place during an emergency."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપતકાલમાં એ જ સ્થળે રહેવા સુરક્ષા માર્ગદર્શિકા."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपातकाल में स्थान पर रहने के लिए सुरक्षा गाइड।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತ್ಯವಸರ ಸಮಯದಲ್ಲಿ ಸ್ಥಳದಲ್ಲೇ ಉಳಿಯುವ ಸುರಕ್ಷತಾ ಮಾರ್ಗದರ್ಶಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടിയണ സമയത്ത് അവിടെ തന്നെ നിൽക്കുന്നതിനുള്ള സുരക്ഷാ മാർഗനിർദേശം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपातकाल में स्थान पर रहने के लिए सुरक्षा गाइड।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਮਰਜੈਂਸੀ ਦੌਰ ਵਿੱਚ ਉਸੇ ਥਾਂ ਰਹਿਣ ਲਈ ਸੁਰੱਖਿਆ ਗਾਈਡ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவசர நிலையில் இடத்திலேயே இருப்பதற்கான பாதுகாப்பு வழிகாட்டி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అత్యవసర సమయంలో స్థానంలో ఉండేందుకు సురక్షా మార్గదర్శకం."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہنگامی حالات میں اسی جگہ رہنے کے لیے حفاظتی رہنمائی"
          }
        }
      }
    },
    "Satellite imagery with roads & labels": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাস্তা ও লেবেলসহ স্যাটেলাইট চিত্র"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellite imagery with roads & labels"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રસ્તા અને લેબલ સાથે સેટેલાઇટ ઇમેજરી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सड़कों और लेबल सहित सैटेलाइट इमेजरी"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಸ್ತೆಗಳು ಮತ್ತು ಲೇಬಲ್‌ಗಳೊಂದಿಗೆ ಉಪಗ್ರಹ ಚಿತ್ರಗಳು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റോഡുകളും ലേബലുകളുമുള്ള സാറ്റലൈറ്റ് ചിത്രങ്ങൾ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सड़कों और लेबल सहित सैटेलाइट इमेजरी"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਾਜਮਾਰਗਾਂ ਅਤੇ ਲੇਬਲ ਨਾਲ ਸੈਟੇਲਾਈਟ ਇਮੇਜਰੀ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாலைகள் & குறியீடுகளுடன் சatellite படங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోడ్లు & లేబుల్‌తో సాటెలైట్ చిత్రాలు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سڑکیں اور لیبل کے ساتھ سیٹلائٹ امیجیری"
          }
        }
      }
    },
    "Saved locally, never uploaded": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয়ভাবে সংরক্ষিত, কখনও আপলোড হয় না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved locally, never uploaded"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાનિક રીતે સાચવેલું, ક્યારેય અપલોડ થતું નથી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से सहेजा गया, कभी अपलोड नहीं"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯವಾಗಿ ಉಳಿಸಲಾಗಿದೆ, ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಮಾಡಲ್ಪಡುವುದಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണത്തിൽ സേവ് ചെയ്തു, ഒരിക്കലും അപ്‌ലോഡ് ചെയ്യില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से सहेजा गया, कभी अपलोड नहीं"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਿਆਈ ਤੌਰ 'ਤੇ ਸੰਭਾਲਿਆ, ਕਦੇ ਅਪਲੋਡ ਨਹੀਂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூராகச் சேமிக்கப்பட்டது, ஒருபோதும் பதிவேற்றப்படுவதில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానికంగా సేవ్ అయ్యింది, ఎప్పుడూ అప్‌లోడ్ కాదు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی طور پر محفوظ، کبھی اپ لوڈ نہیں"
          }
        }
      }
    },
