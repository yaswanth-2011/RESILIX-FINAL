    "A chunk of the transfer is missing.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানান্তরের একটি অংশ অনুপস্থিত।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chunk of the transfer is missing."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાન્સફરનો એક ભાગ ખૂટે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानांतरण का एक हिस्सा गायब है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವರ್ತನೆಯ ಒಂದು ಭಾಗ ಕಾಣಗಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈമാറ്റിന്റെ ഒരു ഭാഗം കണ്ടെത്തിയിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्तांतरणाचा एक भाग गमावला आहे."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਂਸਫਰ ਦਾ ਇੱਕ ਹਿੱਸਾ ਗੁਮ ਹੈ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிமாற்றத்தின் ஒரு பகுதி காணப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బదిలీ భాగం తప్పిపోయింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتقلی کا ایک حصہ موجود نہیں۔"
          }
        }
      }
    },
    "A received SOS alert could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপ্ত SOS সতর্কতা পড়া যায়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A received SOS alert could not be read."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મળેલું SOS ચેતવણી વાંચી શકાયું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्त SOS चेतावनी पढ़ी नहीं जा सकी।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವೀಕರಿಸಿದ ಎಸ್‌ಒಎಸ್ ಎಚ್ಚರಿಕೆಯನ್ನು ಓದಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭിച്ച SOS അറിയിപ്പ് വായിക്കാകാത്തു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्त SOS इशारा वाचता आला नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਲੀ SOS ਚੇਤਾਵਨੀ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெறப்பட்ட SOS எச்சரிக்கையைப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వీకరించిన SOS అలర్ట్ చదవలేకపోయాము."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول شدہ SOS انتباہ نہیں پڑھی جا سکی۔"
          }
        }
      }
    },
