    "Continue until professional help arrives or the person responds.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেশাদার সাহায্য না আসা এবং ব্যক্তি সাড়া না দেওয়া পর্যন্ত চালিয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue until professional help arrives or the person responds."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૃત્તિમાત્ર મદદ આવે અથવા વ્યક્તિ પ્રતિભાવ આપે ત્યાં સુધી ચાલુ રાખો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेशेवर मदद आने या व्यक्ति के प्रतिक्रिया देने तक जारी रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಜ್ಞ ಸಹಾಯ ಬರುವವರೆಗೆ ಅಥವಾ ವ್ಯಕ್ತಿ ಪ್ರತಿಕ್ರಿಯೆ ನೀಡುವವರೆಗೆ ಮುಂದುವರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിദ്യാപ്രദർശന സഹായം വരും വരെയോ ആള് പ്രതികരിക്കും വരെയോ തുടരുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पेशेवर मदद आने या व्यक्ति के प्रतिक्रिया देने तक जारी रखें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੱਕ ਪੇਸ਼ੇਦਾਰ ਮਦਦ ਨਾ ਆਵੇ ਅਤੇ ਵਿਅਕਤੀ ਪ੍ਰਤੀਭਾਵ ਨਾ ਦੇ ਤੱਕ ਜਾਰੀ ਰੱਖੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பட்ட உதவி வருவதும் அல்லது நபர் மீண்டும் உயிர்ப்புணரும் வரை தொடரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాణిక సహాయం రావడం లేదా వ్యక్తి స్పందించే వరకు కొనసాగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماہر مدد آنے یا شخص کا جواب دینے تک جاری رکھیں۔"
          }
        }
      }
    },
