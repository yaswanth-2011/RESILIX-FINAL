    "Search places, devices, shelters": {
      "comment": "A placeholder text for the search bar in the survival map.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জায়গা, ডিভাইস, আশ্রয় খুঁজুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search places, devices, shelters"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થળો, ડિવાઇસ, આશ્રય શોધો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान, डिवाइस, आश्रय खोजें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳಗಳು, ಸಾಧನಗಳು, ಆಶ್ರಯಗಳನ್ನು ಹುಡುಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥലങ്ങൾ, ഉപകരണങ്ങൾ, അറ്റുകളിടങ്ങൾ തിരയുക"
          }
        },
        "mr": {
          "stringUnit": {
