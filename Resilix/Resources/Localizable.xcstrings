    "All clear signal received from sector 7": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৭ নম্বর সেক্টর থেকে নিরাপত্তা সংকেত এসেছে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
