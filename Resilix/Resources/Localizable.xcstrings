    "Route to %@ tested. Next hop %@ via %@": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত পথ পরীক্ষা করা হয়েছে। পরবর্তী হপ %@, %@-এর মাধ্যমে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route to %@ tested. Next hop %@ via %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સુધીનો રસ્તો ચકાસ્યો. આગળનો હોપ %@, %@ માર્ગે"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक का मार्ग परीक्षित किया गया। अगला हॉप %@, %@ के माध्यम से"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ವರೆಗಿನ ಮಾರ್ಗ ಪರೀಕ್ಷಿಸಲಾಗಿದೆ. ಮುಂದಿನ ಹಾಪ್ %@, %@ ಮೂಲಕ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വരെയുള്ള വഴി പരിശോധിച്ചു. അടുത്ത ഹോപ്പ് %@, %@ വഴിയുടെ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर्यंतच्या मार्गाची चाचणी झाली. पुढील हॉप %@, %@ मार्गाने"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੱਕ ਦਾ ਰਾਹ ਜਾਂਚਿਆ ਗਿਆ. ਅਗਲਾ ਹਾਪ %@, %@ ਰਾਹੀਂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வரை வழி சோதிக்கப்பட்டது. அடுத்த ஹாப் %@, %@ வழியாக"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వరకు మార్గం పరీక్షించబడింది. తదుపరి హాప్ %@, %@ ద్వారా"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تک کا راستہ آزمائیا گیا۔ اگلا ہاپ %@، %@ کے ذریعے"
          }
        }
      }
    },
    "Route via Oak St clear. Proceed to checkpoint…": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওক স্ট্রিটের পথ পরিষ্কার। চেকপয়েন্টে এগিয়ে যান…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route via Oak St clear. Proceed to checkpoint…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓક સ્ટ્રીટનો રસ્તો સ્પષ્ટ છે. ચેકપોઇન્ટ સુધી આગળ વધો…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओक स्ट्रीट मार्ग साफ है। चौकी तक बढ़ें…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಓಕ್ ಸ್ಟ್ರೀಟ್ ಮಾರ್ಗ ಸ್ಪಷ್ಟವಾಗಿದೆ. ಚೆಕ್‌ಪಾಯಿಂಟ್‌ಗೆ ಸಾಗಿ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓക്ക് സ്ട്രീറ്റ് വഴി വ്യക്തമാണ്. ചെക്ക്പോയിന്റിലേക്ക് പോകുക…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओक स्ट्रीट मार्ग स्पष्ट आहे. चेकपॉइंकडे जा…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਓਕ ਸਟ੍ਰੀਟ ਰਾਸਤਾ ਸਾਫ਼ ਹੈ। ਚੈੱਕਪੌਇੰਟ ਤੱਕ ਵਧੋ…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஓக் தெரு தெளிவாக உள்ளது. சோதனைப் புள்ளிக்குச் செல்லுங்கள்…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఓక్ స్ట్రీట్ మార్గం స్పష్టంగా ఉంది. చెక్‌పాయింట్‌కు వెళ్లండి…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوک اسٹریٹ کا راستہ صاف ہے۔ چیک پوائنٹ تک آگے بڑھیں…"
          }
        }
      }
    },
