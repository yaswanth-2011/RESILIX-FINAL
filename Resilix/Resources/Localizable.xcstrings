    "Tap Scan to discover Resilix devices around you.": {
      "comment": "A description of the action to scan for nearby Resilix devices.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আশপাশের রেজিলিক্স ডিভাইস খুঁজতে স্ক্যান ট্যাপ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Scan to discover Resilix devices around you."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી આસપાસની રેઝિલિક્સ ડિવાઇસ શોધવા સ્કેન ટેપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आस-पास रेज़िलिक्स डिवाइस खोजने के लिए स्कैन दबाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹತ್ತಿರಿನ ರೆಸಿಲಿಕ್ಸ್ ಸಾಧನಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸ್ಕ್ಯಾನ್ ಒತ್ತಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അടുത്തുള്ള റെസിലിക്സ് ഉപകരണങ്ങൾ കണ്ടെത്താൻ സ്കാൻ അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आस-पास रेज़िलिक्स डिवाइस खोजने के लिए स्कैन दबाएँ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਲੇ ਨੇੜਲਿਆਂ ਦੀਆਂ ਰੈਜ਼ਿਲਿਕਸ ਡਿਵਾਈਸਾਂ ਲੱਭਣ ਲਈ ਸਕੈਨ ਟੈਪ ਕਰੋ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு அருகிலுள்ள ரெசிலிக்ஸ் சாதனங்களைக் கண்டறிய ஸ்கேன் என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దగ్గర రెసిలిక్స్ పరికరాలను కనుగొనడానికి స్కాన్ నొక్కండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی ریزیلکس ڈیوائسز تلاش کرنے کے لیے اسکین ٹیپ کریں۔"
          }
        }
      }
    },
