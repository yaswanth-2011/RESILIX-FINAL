        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਿਕਾਣੇ, ਡਿਵਾਈਸ, ਸ਼ੈਲਟਰ ਖੋਜੋ"
          }
        },
        "ta": {
          "stringUnit": {
