    "Waiting for local network: %@": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় নেটওয়ার্কের অপেক্ষায়: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for local network: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોકલ નેટવર્કની રાહ જોઈ રહ્યા: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय नेटवर्क की प्रतीक्षा: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ಗಾಗಿ ಕಾಯುತ್ತಿದ್ದೇವೆ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോക്കൽ നെറ്റ്‌വർക്കിനായി കാത്തിരിക്കുന്നു: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानिक नेटवर्कची वाट पाहत आहे: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੋਕਲ ਨੈੱਟਵਰਕ ਦੀ ਉਡਤ ਕਰ ਰਹੇ: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் நெட்வர்க் காத்திருக்கிறது: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లోకల్ నెట్‌వర్క్ కోసం వేచి ఉంది: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی نیٹ ورک کا انتظار: %@"
          }
        }
      }
    },
    "Warm the center of the body first — chest, neck, head, groin.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে শরীরের মাঝখানের অংশ গরম করুন — বুক, ঘাড়, মাথা, কোমর."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm the center of the body first — chest, neck, head, groin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરનો મધ્યભાગ પહેલા ગરમ કરો — છાતી, ગળો, માથું, ગભોઘમ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के मध्य भाग को पहले गरम करें — छाती, गर्दन, सिर, श्रिणि."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲು ದೇಹದ ಮಧ್ಯಭಾಗವನ್ನು ಬೆಚ್ಚಗಿಸಿ — ಎಲ್ಬುಡಿ, ಕಂಠ, ತಲ, ಗುರುದೆಯ ಭಾಗ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം ശരീരത്തിന്റെ മധ്യഭാഗം ചൂടുകാക്കുക — മാറ്റ്, കഴുത്ത്, തലം, ഇടുപ്പ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के मध्य भाग को पहले गरम करें — छाती, गर्दन, सिर, श्रिणि."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے جسم کے وسطی حصے کو گرم کریں — سینے، گردن، سر، کمر کا حصہ۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் உடலின் மையப் பகுதியை வெப்பமாக்கவும் — மார்பு, கழுத்து, தலை, இடுப்புப் பகுதி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదట శరీర మధ్య భాగాన్ని వేడి చేయండి — గుండె, మెక్కు, తల, చిగుళ్లు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Wash or cover your hands if possible.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্ভব হলে হাত ধুয়ে নিন বা ঢেকে রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash or cover your hands if possible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમાવ હોય તો હાથ ધોવો અથવા ઢાંકો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि संभव हो तो हाथ धोएँ या ढकें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧ್ಯವಾದರೆ ಕೈಗಳನ್ನು ತೊಳೆಯಿರಿ ಅಥವಾ ಮುಚ್ಚಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധ്യമെങ്കിൽ കൈകൾ കഴിയുക അല്ലെങ്കിൽ മൂടക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संभव असल्यास हाथ धुवा किंवा झाका."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਸੰਭਵ ਹੋਵੇ ਤਾਂ ਹੱਥ ਧੋਵੋ ਜਾਂ ਢੱਕੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாத்தியமானால் கைகளைக் கழுவுங்கள் அல்லது மூடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధ్యమైతే చేతులను కడగొట్టండి లేదా కప్పండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر ممکن ہو تو ہاتھ دھوئیں یا ڈھکیں۔"
          }
        }
      }
    },
    "Watch packet travel the mesh": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
