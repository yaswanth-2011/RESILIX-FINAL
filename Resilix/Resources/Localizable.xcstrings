        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరీక్ష ప్యాకెట్ %@ పీర్‌కు పంపబడింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیسٹ پیکٹ %@ پیئر کو بھیجا گیا۔"
