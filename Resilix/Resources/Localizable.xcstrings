        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેક્ટર 7 થી સુરક્ષા સંકેત મળ્યો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेक्टर 7 से सुरक्षा संकेत मिला"
