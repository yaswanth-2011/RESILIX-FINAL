    "Apply a cold pack wrapped in cloth to reduce swelling.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোলা কমাতে কাপড়ে মোড়ানো কোল্ড প্যাক ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a cold pack wrapped in cloth to reduce swelling."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂજવો ઘટાડવા કપડામાં લપાવેલો ઠંડો પેક વાપરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूजन घटाने के लिए कपड़े में लपेटा हुआ ठंडा पैक लगाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಊಬ್ಬು ಕಡಿಮೆಮಾಡಲು ಗೆರೆಯಲ್ಲಿ ಸುತ್ತಿದ ತಂಪು ಚೀಲ ಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീക്കം കുറയ്ക്കാൻ തുക്കിൽ പൊതിഞ്ഞ തണുപ്പുപെട്ട് ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूजन घटाने के लिए कपड़े में लपेटा हुआ ठंडा पैक लगाएँ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਜਣ ਘਟਾਉਣ ਲਈ ਕੱਪੜੇ ਵਿੱਚ ਲਪੇਟਿਆ ਠੰਡਾ ਪੈਕ ਲਗਾਓ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீக்கத்தைக் குறைக்க துணியில் சுற்றி குளிர் பை பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఊబ్బు కడిమైమేయడానికి గెరె మూడిన తంపు బ్యాగ్ వాడండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوزش کم کرنے کے لیے کپڑے میں لپیٹا ٹھنڈا پیک لگائیں۔"
          }
        }
      }
    },
    "Apply a splint in the position found, padding around it.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেভাবে পাওয়া গেছে সেই অবস্থাতেই স্প্লিন্ট বাঁধুন, তার চারপাশে নরম কিছু রাখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a splint in the position found, padding around it."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જેમ મળ્યું તેમ જ સ્થિતિમાં સ્પ્લિન્ટ બાંધો, તેની આસપાસ નરમ ગાદી રાખો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस स्थिति में मिला हो उसी स्थिति में पट्टी बाँधें, उसके चारों ओर गद्दी रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅದು ಕಂಡ ಸ್ಥಿತಿಯಲ್ಲಿಯೇ ಸ್ಪ್ಲಿಂಟ್ ಹಾಕಿ, ಅದರ ಸುತ್ತ ಮೃದು ಹೆಣೆ ಇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണ്ടതന്ന നിലയിൽ തന്നെ സ്പ്ലിന്റ് ഉപയോഗിച്ച്, അതിന് ചുറ്റും മൃദുവായ പതിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस स्थिति में मिला हो उसी स्थिति में पट्टी बाँधें, उसके चारों ओर गद्दी रखें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "جیسے ملا ویسے ہی حالت میں اسپلنٹ لگائیں، اس کے گرد نرم پھری بچھائیں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காணப்பட்ட நிலையில் சிலிண்ட் போட்டு, அதைச் சுற்றி மென்மையான பொருள் வைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది కనిపించిన స్థితిలోనే స్ప్లింట్ పెట్టండి, దాని చుట్టూ మృదువైన పదార్థం వేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Apply firm, direct pressure with a clean cloth or bandage.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার কাপড় বা ব্যান্ডেজ দিয়ে শক্তভাবে সরাসরি চাপ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply firm, direct pressure with a clean cloth or bandage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વચ્છ કપડાં અથવા પાટું થી મજબૂતીથી સીધું દબાણ આપો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ कपड़े या पट्टी से ज़ोर से सीधा दबाव डालें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛ ಗೆರೆ ಅಥವಾ ಬ್ಯಾಂಡೇಜಿನಿಂದ ಗಟ್ಟಿಯಾಗಿ ನೇರವಾಗಿ ಒತ್ತಡ ಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തമായ തുക്കുകൊപ്പോ അല്ലെങ്കിൽ ബാന്ഡേജിലൂടെ ശക്തമായി നേരിലുള്ള അമർത്തും പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ कपड़े या पट्टी से ज़ोर से सीधा दबाव डालें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਫ਼ ਕੱਪੜਾ ਜਾਂ ਪੱਟੀ ਨਾਲ ਮਜ਼ਬੂਤੀ ਨਾਲ ਸਿੱਧਾ ਦਬਾਅ ਪਾਓ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தமான துணி அல்லது பட்டையால் உறுதியாக நேரடியாக அழுத்தம் போடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వచ్ఛమైన దుడ్డి లేదా బ్యాండేజీతో బలంగా, నేరుగా ఒత్తిడి పెట్టండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صاف کپڑے یا پٹی سے مضبوط اور براہِ راست دباؤ دیں۔"
          }
        }
      }
    },
    "Are you safe? We're at the community shelter o…": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিরাপদ? আমরা সম্প্রদায় আশ্রয়ে আছি…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you safe? We're at the community shelter o…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સુરક્ષિત છો? અમે સમુદાય આશ્રયમાં છીએ…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप सुरक्षित हैं? हम सामुदायिक आश्रय पर हैं…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸುರಕ್ಷಿತರಾ? ನಾವು ಸಮುದಾಯ ಆಶ್ರಯದಲ್ಲಿದ್ದೇವೆ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സുരക്ഷിതരാണോ? ഞങ്ങൾ സമൂഹ അറ്റുമനത്തിലാണ്…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सुरक्षित आहात का? आम्ही समाज आश्रयात आहोत…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਸੁਰੱਖਿਅਤ ਹੋ? ਅਸੀਂ ਭਾਈਚਾਰਾ ਆਸਰੇ ਵਿੱਚ ਹਾਂ…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பாதுகாப்பாக உள்ளீர்களா? நாங்கள் சமூகக் காப்பகத்தில் உள்ளோம்…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు క్షేమం ఉన్నారా? మేము సముదాయ ఆశ్రయంలో ఉన్నాము…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ محفوظ ہیں؟ ہم کمیونٹی پناہ گاہ پر ہیں…"
          }
        }
      }
    },
    "Are you sure you want to log out?": {
      "comment": "A confirmation message for logging out.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিতভাবে লগ আউট করতে চান?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to log out?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરીખર લોગ આઉટ કરવા માંગો છો?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई लॉग आउट करना चाहते हैं?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಜವಾಗಿ ಲಾಗ್ ಔಟ್ ಮಾಡಬೇಕೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ശ്രദ്ധിക്കുന്നുണ്ടോ ലോഗ് ഔട്ട് ചെയ്യണം?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई लॉग आउट करना चाहते हैं?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਸੱਚੀ ਲੋਗ ਆਊਟ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உண்மையிலும் வெளியேற விரும்புகிறீர்களா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నిజ్జీ లాగ్ అవుట్ చేయాలనుకుంటున్నారా?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی لاگ آؤٹ کرنا چاہتے ہیں؟"
          }
        }
      }
    },
