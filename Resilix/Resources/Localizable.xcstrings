    "Alternate back blows and abdominal thrusts until the object clears.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বস্তু না বেরোনো পর্যন্ত পিঠে চাপড়া ও পেটে চাপ দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate back blows and abdominal thrusts until the object clears."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વસ્તુ બહાર ન આવે ત્યાં સુધી પીઠ પર થપકો અને પેટ પર થપકો બારીબારી કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक वस्तु न निकल जाए, पीठ पर थपकी और पेट पर थपकी बारी-बारी करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಸ್ತು ಹೊರಬರುವವರೆಗೆ ಹಿಂಬಿನ ತಟ್ಟುಗಳು ಮತ್ತು ಉದರ ಒತ್ತಡಗಳನ್ನು ಅಲ್ಪಾಲ್ಪಾಗಿ ಬದಲಾಯಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വസ്തു പുറത്തുവരും വരെ പിൻകാൽ അടിപ്പറപ്പുകളും വയറ്റിലെ അമർത്തലുകളും ഇടയ്ക്ക് മാറ്റിവരുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक वस्तु न निकल जाए, पीठ पर थपकी और पेट पर थपकी बारी-बारी करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک چیز نہ نکلے، پیٹ پر اور پشت پر باری باری تھپکار دیں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வஸ்து புறத்துக்கு வரும் வரை பின் தட்டுகள், வயிற்று அமுக்கங்கள் மாறிமாறி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వస్తువు బయటకు వరకు వెనుక కొట్టడం, ఉదర ఒత్తిడులు మార్పిడిగా చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਵਸਤੂ ਨਿਕਲ ਨਾ ਜਾਵੇ, ਪਿੱਠ 'ਤੇ ਥਪਕੋ ਅਤੇ ਪੇਟ 'ਤੇ ਥਪਕੋ ਬਾਰੀ-ਬਾਰੀ।"
          }
        }
      }
    },
    "Always available, no model needed": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবসময় উপলব্ধ, কোনো মডেল লাগে না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always available, no model needed"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હંમેશા ઉપલબ્ધ, મોડલની જરૂર નથી"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा उपलब्ध, किसी मॉडल की आवश्यकता नहीं"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವಾಗಲೂ ಲಭ್ಯ, ಮಾದರಿಯ ಅಗತ್ಯವಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എപ്പോഴും ലഭ്യം, മോഡൽ ആവശ്യമില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेहमी उपलब्ध, मॉडेलची गरज नाही"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਮੇਸ਼ਾ ਉਪਲਬਧ, ਕੋਈ ਮਾਡਲ ਲੋੜੀਂਦਾ ਨਹੀਂ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எப்பவும் கிடைக்கும், மாடல் தேவையில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎప్పుడూ అందుబాటులో, మోడల్ అవసరం లేదు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیشہ دستیاب، کسی ماڈل کی ضرورت نہیں"
          }
        }
      }
    },
    "Always seek professional help for any cardiac event.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো হৃদয়সংক্রান্ত ঘটনায় সবসময় পেশাদার সাহায্য নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always seek professional help for any cardiac event."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હૃદય સંબંધિત કોઈપણ ઘટનામાં હંમેશા વૃત્તિમાત્ર સહાય લો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदय संबंधी किसी भी घटना में हमेशा पेशेवर सहायता लें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೃದಯ ಸಂಬಂಧಿತ ಯಾವುದೇ ಘಟನೆಯಲ್ಲಿ ಯಾವಾಗಲೂ ವೈದ್ಯ ಸಹಾಯ ಪಡೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹൃദയം സംബന്ധിച്ച ഏത് സംഭവത്തിനും എപ്പോഴും ഡോക്ടർ സഹായം തേടുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदय संबंधी किसी भी घटना में हमेशा पेशेवर सहायता लें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਵਿਧ ਹ੃ਦਯ ਸੰਬੰਧੀ ਘਟਨਾ ਵਿੱਚ ਹਮੇਸ਼ਾ ਪੇਸ਼ੇਦਾਰ ਮਦਦ ਲਓ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதயம் சார்ந்த எந்த நிகழ்வுக்கும் எப்பவும் தனிப்பட்ட உதவியை அழைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా హృదయ సంబంధిత సంఘటన జరిగినప్పుడు ఎప్పుడూ వైద్య సహాయం తీసుకోండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر دل سے متعلق واقعے میں ہمیشہ ماہر مدد لیں۔"
          }
        }
      }
    },
