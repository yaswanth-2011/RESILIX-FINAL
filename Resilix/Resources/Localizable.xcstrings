    "Mesh discovery requires Bluetooth. Enable in Settings if denied.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেশ আবিষ্কারের জন্য Bluetooth প্রয়োজন। অনুমতি না দিলে সেটিংসে চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesh discovery requires Bluetooth. Enable in Settings if denied."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેશ શોધવા માટે Bluetooth જરૂરી. નિષેધ થાય તો સેટિંગ્સમાં સક્રિય કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेश खोज के लिए Bluetooth आवश्यक है। अनुमति न हो तो सेटिंग्स में सक्षम करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಶ್ ಅನ್ವೇಷಣೆಗೆ Bluetooth ಅಗತ್ಯ. ನಿರಾಕರಿಸಿದರೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಆನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെഷ് കണ്ടെത്തൽക്ക് Bluetooth വേണം. നിഷേധിച്ചാൽ ക്രമീകരണങ്ങളിൽ ഓൺ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेश शोधण्यासाठी Bluetooth आवश्यक. नकार दिल्यास सेटिंग्जमध्ये सक्षम करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਸ਼ ਖੋਜ ਲਈ Bluetooth ਲੋੜੀਂਦਾ ਹੈ। ਇਨਕਾਰ ਹੋਵੇ 'ਤੇ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெஷ் கண்டுபிடிப்புக்கு Bluetooth தேவை. மறுக்கப்பட்டால் அமைப்புகளில் இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెష్ అన్వేషణకు Bluetooth అవసరం. నిరాకరించినట్లయితే సెట్టింగ్‌లలో ప్రారంభించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میش تلاش کے لیے Bluetooth درکار ہے۔ اجازت نہ دی جائے تو سیٹنگز میں فعال کریں۔"
          }
        }
      }
    },
