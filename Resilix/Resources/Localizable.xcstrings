        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒದ್ದ ಬಟ್ಟೆ ತೆಗೆದು ಒಣ ಪದರಗಳಿಂದ ಬದಲಾಯಿಸಿ, ತಲವನ್ನು ಮುಚ್ಚಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈരപ്പുള്ള വസ്ത്രങ്ങൾ എടുത്ത് ഉണക്ക പാളകളാക്കി, തല മൂടുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गीले कपड़े हटाएँ और सूखी परतें पहनें, सिर ढकें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیلے کپڑے اتار کر خشک تہےں پہنیں، سر ڈھکیں۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஈரமான ஆடைகளை அகற்றி உலர்ந்த படைகளால் மாற்றி, தலையை மூடவும்."
          }
