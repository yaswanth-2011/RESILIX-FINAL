            "value": "സന്ദേശ കാലാവധി അനുമതി ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश समाप्ति सक्षम करें"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਨੇਹੇ ਦੀ ਮਿਆਦ ਚਾਲੂ ਕਰੋ"
