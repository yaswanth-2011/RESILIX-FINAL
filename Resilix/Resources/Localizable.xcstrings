{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not installed on this device yet.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এখনও এই ডিভাইসে ইনস্টল করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not installed on this device yet."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ હજી આ ડિવાઇસ પર ઇન્સ્ટોલ કર્યું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी इस डिवाइस पर इंस्टॉल नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಇನ್ನೂ ಈ ಸಾಧನದಲ್ಲಿ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഇതുവരെ ഈ ഉപകരണത്തിൽ ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अद्याप या डिव्हाइसवर इन्स्टॉल केलेला नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਹਾਲੇ ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਇੰਸਟਾਲ ਨਹੀਂ ਕੀਤਾ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன்னும் இந்தச் சாதனத்தில் நிறுவப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఇంకా ఈ డివైస్‌లో ఇన్‌స్టాల్ చేయలేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ابھی اس ڈیوائس پر انسٹال نہیں ہوا۔"
          }
        }
      }
    },
    "%@ reported with %@ severity.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ তীব্রতা সহ রিপোর্ট করা হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reported with %@ severity."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ તીવ્રતા સાથે રિપોર્ટ કરેલું."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ गंभीरता के साथ रिपोर्ट किया गया।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ತೀವ್ರತೆಯೊಂದಿಗೆ ವರದಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ഗുരുതരമായ അവസ്ഥയിൽ റിപ്പോർട്ട് ചെയ്തു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ गंभीरता के साथ रिपोर्ट किया गया।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ ਗੁਰੂਤਾ ਨਾਲ ਰਿਪੋਰਟ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ தீவிரத்துடன் அறிக்கை செய்யப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ తీవ్రతతో నివేదించబడింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو %@ شدت کے ساتھ رپورٹ کیا گیا۔"
          }
        }
      }
    },
