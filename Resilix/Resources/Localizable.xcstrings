    "Test packet sent to %@ peer(s).": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পিয়ারকে পরীক্ষা প্যাকেট পাঠানো হয়েছে।"
