    "Your private AI assistant, running entirely on your device.": {
      "comment": "A description of the Assist app.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিগত AI সহকারী, সম্পূর্ণভাবে আপনার ডিভাইসেই চলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private AI assistant, running entirely on your device."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ખાનગી AI સહાયક, સંપૂર્ણ રીતે તમારા ડિવાઇસ પર જ ચાલે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका निजी एआई सहायक, पूरी तरह आपके डिवाइस पर चलता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖಾಸಿ AI ಸಹಾಯಕ, ಪೂರ್ಣವಾಗಿ ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്വകാര്യ AI സഹായി, പൂർണ്ണമായി നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ പ്രവർത്തിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका निजी एआई सहायक, पूरी तरह आपके डिवाइस पर चलता है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਨਿੱਜੀ AI ਸਹਾਇਕ, ਪੂਰੀ ਤਰ੍ਹਾਂ ਤੁਹਾਡੇ ਡਿਵਾਈਸ 'ਤੇ ਹੀ ਚੱਲਦਾ ਹੈ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தனியான AI உதவியாளர், முற்றிலும் உங்கள் சாதனத்திலேயே இயங்குகிறார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వ్యక్తిగత AI సహాయకుడు, పూర్తిగా మీ పరికరంలోనే పనిచేస్తాడు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نجی AI معاون، مکمل طور پر آپ کے ڈیوائس پر ہی چلتا ہے۔"
          }
        }
      }
    },
