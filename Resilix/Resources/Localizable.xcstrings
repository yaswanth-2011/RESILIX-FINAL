    "Smallest Qwen3 release. Qwen3.5 starts at 0.8B, there is no Qwen3.5 0.6B.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে ছোট Qwen3 রিলিজ। Qwen3.5 0.8B থেকে শুরু, Qwen3.5 0.6B নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smallest Qwen3 release. Qwen3.5 starts at 0.8B, there is no Qwen3.5 0.6B."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી નાનું Qwen3 રિલીઝ. Qwen3.5 0.8B થી શરૂ, Qwen3.5 0.6B નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे छोटा Qwen3 रिलीज़। Qwen3.5 0.8B से शुरू होता है, Qwen3.5 0.6B मौजूद नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತಿ ಚಿಕ್ಕ Qwen3 ಬಿಡುಗಡೆ. Qwen3.5 0.8Bಯಿಂದ ಆರಂಭ, Qwen3.5 0.6B ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും ചെറിയ Qwen3 റിലീസ്. Qwen3.5 0.8B മുതൽ തുടങ്ങുന്നു, Qwen3.5 0.6B ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वात लहान Qwen3 प्रकाशन. Qwen3.5 0.8B पासून सुरू होते, Qwen3.5 0.6B नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਛੋਟਾ Qwen3 ਰੀਲੀਜ਼। Qwen3.5 0.8B ਤੋਂ ਸ਼ੁਰੂ, Qwen3.5 0.6B ਨਹੀਂ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிகச் சிறிய Qwen3 வெளியீடு. Qwen3.5 0.8B முதல் தொடங்குகிறது, Qwen3.5 0.6B இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అతి చిన్న Qwen3 విడుదల. Qwen3.5 0.8B నుండి మొదలవుతుంది, Qwen3.5 0.6B లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے چھوٹا Qwen3 ریلیز۔ Qwen3.5 0.8B سے شروع ہوتا ہے، Qwen3.5 0.6B موجود نہیں۔"
          }
        }
      }
    },
    "Soft, low-saturation map for overview": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহজ দৃশ্যের জন্য নরম, কম রঙের মানচিত্র"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft, low-saturation map for overview"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરળ દૃષ્ટિ માટે નરમ, ઓછા રંગનું નકશો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहज नज़र के लिए हल्का, कम रंगों वाला मैप"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವಲೋಕನಕ್ಕೆ ಮೃದು, ಕಡಿಮೆ ಸಂತೃಪ್ತಿಯ ನಕ್ಷೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒവലീക്കാൻ മൃദുവായ, കുറഞ്ഞ സാച്ചരമുള്ള ഭൂട്ടം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहज नज़र के लिए हल्का, कम रंगों वाला मैप"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੌਖੀ ਨਜ਼ਰ ਲਈ ਹਲਕਾ, ਘੱਟ ਰੰਗਾਂ ਵਾਲਾ ਨਕਸ਼ਾ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலோட்டப் பார்வைக்கு மென்மையான, குறைந்த செறிவுள்ள வரைபடம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మృదువైన, తక్కువ సంతృప్తి మ్యాప్ overview కోసం"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم رنگوں والا نقشہ آسان نظارے کے لیے"
          }
        }
      }
    },
