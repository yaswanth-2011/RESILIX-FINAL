            "state": "translated",
            "value": "പൊതു ഗതാഗമനം വിലക്കുന്ന ഭൂട്ടം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक वाहतूक अधोक्त दाखवणारा नकाशा"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਨਤਕ ਆਵਾਜਾਈ ਉਜਾਗਰ ਕਰਨ ਵਾਲਾ ਨਕਸ਼ਾ"
          }
        },
        "ta": {
