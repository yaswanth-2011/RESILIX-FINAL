        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಮೇಲ್ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇമെയിലും പാസ്‌വേഡും നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
