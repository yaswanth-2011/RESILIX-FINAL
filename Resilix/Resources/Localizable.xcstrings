    "Provided by the system, nothing has to be downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম দ্বারা প্রদত্ত, কিছুই ডাউনলোড করতে হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provided by the system, nothing has to be downloaded."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ દ્વારા પૂરું પાડેલું, કંઈ ડાઉનલોડ કરવાનું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम द्वारा प्रदान किया गया, कुछ भी डाउनलोड नहीं करना।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವ್ಯವಸ್ಥೆಯಿಂದ ಒದಗಿಸಲಾಗಿದೆ, ಏನೂ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬೇಕಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റമിലൽ നൽകിയത്, ഒന്നും ഡൗൺലോഡ് ചെയ്യേണ്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रणालीने पुरवले, काहीही डाउनलोड करण्याची गरज नाही."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਵੱਲੋਂ ਦਿੱਤਾ ਗਿਆ, ਕੁਝ ਵੀ ਡਾਊਨਲੋਡ ਕਰਨਾ ਨਹੀਂ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி வழங்கியது, எதுவும் பதிவிறக்கத் தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ అందించినది, ఏమీ డౌన్‌లోడ్ చేయనవసరం లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کی فراہم کردہ، کچھ بھی ڈاؤن لوڈ نہیں کرنا۔"
          }
        }
      }
    },
