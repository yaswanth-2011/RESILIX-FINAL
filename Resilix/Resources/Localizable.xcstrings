            "value": "જાહેર વાહનવ્યવહાર સ્પષ્ટ કરતું નકશો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक परिवहन पर ज़ोर देने वाला मैप"
