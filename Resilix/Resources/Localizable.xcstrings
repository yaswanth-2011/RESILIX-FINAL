    "Send %@ %@ alert via mesh?": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেশের মাধ্যমে %@ %@ সতর্কতা পাঠাবেন?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send %@ %@ alert via mesh?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેશ દ્વારા %@ %@ ચેતવણી મોકલવી છે?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेश के ज़रिए %@ %@ चेतावनी भेजें?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಶ್ ಮೂಲಕ %@ %@ ಎಚ್ಚರಿಕೆ ಕಳುಹಿಸಬೇಕೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെഷ് വഴി %@ %@ അറിയിപ്പ് അയയ്ക്കണോ?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेशद्वारे %@ %@ इशारा पाठवायचा?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਸ਼ ਰਾਹੀਂ %@ %@ ਚੇਤਾਵਨੀ ਭੇਜੀਏ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெஷ் வழியாக %@ %@ எச்சரிக்கையை அனுப்பவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెష్ ద్వారా %@ %@ అలర్ట్ పంపాలా?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میش کے ذریعے %@ %@ انتباہ بھیجیں؟"
          }
        }
      }
    },
