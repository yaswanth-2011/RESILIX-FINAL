        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹತ್ತಿರದ ಆಶ್ರಯ ಮತ್ತು ಆಸ್ಪತ್ರ ಎಲ್ಲಿದೆ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തുള്ള അറ്റുകളിടവും ആശുപത്രിയും എവിടെയുണ്ട്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़दीकी आश्रय और अस्पताल कहाँ है?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੇੜਲਾ ਸ਼ੈਲਟਰ ਅਤੇ ਹਸਪਤਾਲ ਕਿੱਥੇ ਹੈ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அருகிலுள்ள தங்குமிடமும் மருத்துவமும் எங்கே உள்ளன?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరి ఆశ్రయం మరియు ఆస్పత్రి ఎక్కడ ఉన్నాయి?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی پناہ گاہ اور ہسپتال کہاں ہے؟"
          }
        }
      }
    },
