    "error.generic": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ত্রুটি হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred. Please try again."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક ભૂલ થઈ. કૃપા કરીને ફરી પ્રયત્ન કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक त्रुटि हुई। कृपया फिर से प्रयास करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ದೋಷ ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പിഴച്ചം സംഭവിച്ചു. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक त्रुटी आली. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਗਲਤੀ ਹੋਈ। ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక పొరపాటు జరిగింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک خرابی پیش آئی۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        }
      }
    },
