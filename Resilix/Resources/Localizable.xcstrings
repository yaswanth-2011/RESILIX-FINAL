          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തുള്ള സഹായം കണ്ടെത്തുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जवळपास मदत शोधा"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੇੜਲੇ ਮਦਦ ਲੱਭੋ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அருகிலேயே உதவியைக் கண்டறியவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరే సహాయం కనుగొనండి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی مدد تلاش کریں"
          }
        }
      }
    },
    "Find nearby Resilix users to start communicating.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথন শুরু করতে কাছের রেজিলিক্স ব্যবহারকারী খুঁজুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find nearby Resilix users to start communicating."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વાતચીત શરૂ કરવા નજીકના રેઝિલિક્સ વપરાશકરો શોધો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संवाद शुरू करने के लिए आस-पास के रेज़िलिक्स उपयोगकर्ता खोजें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂವಾದ ಆರಂಭಿಸಲು ಹತ್ತಿರದ ರೆಸಿಲಿಕ್ಸ್ ಬಳಕೆದಾರರನ್ನು ಕಂಡುಹಿಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംഭാഷണം ആരംഭിക്കാൻ അടുത്തുള്ള റെസിലിക്സ് ഉപയോക്താക്കളെ കണ്ടെത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संवाद सुरू करण्यासाठी जवळपासचे रेज़िलिक्स वापरकर्ते शोधा."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੱਲਬਾਤ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਨੇੜਲਿਆਂ ਰੈਜ਼ਿਲਿਕਸ ਵਰਤੋਂਕਾਰ ਲੱਭੋ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச்சைத் தொடங்க அருகிலுள்ள ரெசிலிக்ஸ் பயனர்களைக் கண்டறியவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంవాదం ప్రారంభించడానికి దగ్గరి రెసిలిక్స్ వినియోగదారులను కనుగొనండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگو شروع کرنے کے لیے قریبی ریزیلکس صارفین تلاش کریں۔"
          }
        }
      }
    },
